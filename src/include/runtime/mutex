#ifndef _CPC_MUTEX
#define _CPC_MUTEX

#include <cprime_thread.h>
#include <new>
#include <tuple>

namespace std
{
  class mutex
  {
  public:
    typedef void *native_handle_type;
    mutex() : m_mutex(__cpc_windows_mutex_create(0)) { if (!m_mutex) throw bad_alloc(); }
    ~mutex() { __cpc_windows_mutex_destroy(m_mutex); }
    mutex(const mutex &) = delete;
    mutex &operator=(const mutex &) = delete;
    void lock() { __cpc_windows_mutex_lock(m_mutex); }
    bool try_lock() { return __cpc_windows_mutex_try_lock(m_mutex) != 0; }
    void unlock() { __cpc_windows_mutex_unlock(m_mutex); }
    native_handle_type native_handle() { return m_mutex; }
  private:
    void *m_mutex;
  };

  class recursive_mutex
  {
  public:
    typedef void *native_handle_type;
    recursive_mutex() : m_mutex(__cpc_windows_mutex_create(1)) { if (!m_mutex) throw bad_alloc(); }
    ~recursive_mutex() { __cpc_windows_mutex_destroy(m_mutex); }
    recursive_mutex(const recursive_mutex &) = delete;
    recursive_mutex &operator=(const recursive_mutex &) = delete;
    void lock() { __cpc_windows_mutex_lock(m_mutex); }
    bool try_lock() { return __cpc_windows_mutex_try_lock(m_mutex) != 0; }
    void unlock() { __cpc_windows_mutex_unlock(m_mutex); }
    native_handle_type native_handle() { return m_mutex; }
  private:
    void *m_mutex;
  };

  template<class T>
  class lock_guard
  {
  public:
    explicit lock_guard(T &m) : m_mutex(m) { m_mutex.lock(); }
    ~lock_guard() { m_mutex.unlock(); }
    lock_guard(const lock_guard &) = delete;
    lock_guard &operator=(const lock_guard &) = delete;
  private:
    T &m_mutex;
  };

  struct defer_lock_t { explicit defer_lock_t() {} };
  struct try_to_lock_t { explicit try_to_lock_t() {} };
  struct adopt_lock_t { explicit adopt_lock_t() {} };

  const defer_lock_t defer_lock;
  const try_to_lock_t try_to_lock;
  const adopt_lock_t adopt_lock;

  namespace __cpc_scoped_lock_detail
  {
    struct locker
    {
      template<class... Mutexes>
      void operator()(Mutexes *...mutexes) const
      {
        int sequence[] = { (mutexes->lock(), 0)... };
        (void)sequence;
      }
    };

    struct unlocker
    {
      template<class... Mutexes>
      void operator()(Mutexes *...mutexes) const
      {
        int sequence[] = { (mutexes->unlock(), 0)... };
        (void)sequence;
      }
    };
  }

  /* A plain class rather than a class template: the standard spelling
     `std::scoped_lock lock(m);` has no template argument list, and this
     compiler deduces class arguments only from braced initializers. The
     variadic constructor records type-erased lock/unlock thunks, so one
     definition covers every mutex type and any number of them. The standard
     locks the whole set without deadlock; this minimal form takes them in
     the order written, which is what a caller passing distinct, consistently
     ordered mutexes relies on. */
  class scoped_lock
  {
  public:
    enum { max_mutexes = 8 };

    template<class... Mutexes>
    explicit scoped_lock(Mutexes &...mutexes) : m_count(0), m_owns(false)
    {
      int sequence[] = { (record(&mutexes), 0)... };
      (void)sequence;
      lock();
    }

    ~scoped_lock()
    {
      if (m_owns) unlock();
    }

    scoped_lock(const scoped_lock &) = delete;
    scoped_lock &operator=(const scoped_lock &) = delete;

    scoped_lock(scoped_lock &&other) : m_count(other.m_count), m_owns(other.m_owns)
    {
      copy_entries(other);
      other.m_owns = 0;
      other.m_count = 0;
    }

    scoped_lock &operator=(scoped_lock &&other)
    {
      if (this != &other)
      {
        if (m_owns) unlock();
        m_count = other.m_count;
        copy_entries(other);
        m_owns = other.m_owns;
        other.m_owns = 0;
        other.m_count = 0;
      }
      return *this;
    }

    void lock()
    {
      for (int i = 0; i < m_count; ++i) m_lock[i](m_mutexes[i]);
      m_owns = 1;
    }

    void unlock()
    {
      for (int i = m_count - 1; i >= 0; --i) m_unlock[i](m_mutexes[i]);
      m_owns = 0;
    }

  private:
    template<class Mutex>
    static void lock_thunk(void *mutex) { static_cast<Mutex *>(mutex)->lock(); }
    template<class Mutex>
    static void unlock_thunk(void *mutex) { static_cast<Mutex *>(mutex)->unlock(); }

    template<class Mutex>
    void record(Mutex *mutex)
    {
      if (m_count == max_mutexes) return;
      m_mutexes[m_count] = mutex;
      m_lock[m_count] = &lock_thunk<Mutex>;
      m_unlock[m_count] = &unlock_thunk<Mutex>;
      ++m_count;
    }

    void copy_entries(const scoped_lock &other)
    {
      for (int i = 0; i < m_count; ++i)
      {
        m_mutexes[i] = other.m_mutexes[i];
        m_lock[i] = other.m_lock[i];
        m_unlock[i] = other.m_unlock[i];
      }
    }

    void *m_mutexes[max_mutexes];
    void (*m_lock[max_mutexes])(void *);
    void (*m_unlock[max_mutexes])(void *);
    int m_count;
    int m_owns;
  };

  template<class T>
  class unique_lock
  {
  public:
    unique_lock() : m_mutex(0), m_owns(false) {}
    explicit unique_lock(T &m) : m_mutex(&m), m_owns(true) { m_mutex->lock(); }
    ~unique_lock() { if (m_owns) m_mutex->unlock(); }
    unique_lock(const unique_lock &) = delete;
    unique_lock &operator=(const unique_lock &) = delete;
    unique_lock(unique_lock &&other) : m_mutex(other.m_mutex), m_owns(other.m_owns)
    { other.m_mutex = 0; other.m_owns = false; }
    unique_lock &operator=(unique_lock &&other)
    {
      if (this != &other) {
        if (m_owns) m_mutex->unlock();
        m_mutex = other.m_mutex; m_owns = other.m_owns;
        other.m_mutex = 0; other.m_owns = false;
      }
      return *this;
    }
    void lock() { m_mutex->lock(); m_owns = true; }
    bool try_lock() { m_owns = m_mutex->try_lock(); return m_owns; }
    void unlock() { m_mutex->unlock(); m_owns = false; }
    bool owns_lock() const { return m_owns; }
    explicit operator bool() const { return m_owns; }
    T *mutex() const { return m_mutex; }
    T *release() { T *result = m_mutex; m_mutex = 0; m_owns = false; return result; }
  private:
    T *m_mutex;
    bool m_owns;
  };

  class condition_variable
  {
  public:
    condition_variable() : m_condition(__cpc_windows_condition_create())
    { if (!m_condition) throw bad_alloc(); }
    ~condition_variable() { __cpc_windows_condition_destroy(m_condition); }
    condition_variable(const condition_variable &) = delete;
    condition_variable &operator=(const condition_variable &) = delete;
    void notify_one() { __cpc_windows_condition_notify(m_condition, 0); }
    void notify_all() { __cpc_windows_condition_notify(m_condition, 1); }
    void wait(unique_lock<mutex> &lock)
    { __cpc_windows_condition_wait(m_condition, lock.mutex()->native_handle()); }
    template<class Predicate> void wait(unique_lock<mutex> &lock, Predicate ready)
    { while (!ready()) wait(lock); }
  private:
    void *m_condition;
  };
}

#endif
