#ifndef _CPC_TYPEINDEX
#define _CPC_TYPEINDEX

#include <typeinfo>

namespace std
{
  class type_index
  {
  public:
    explicit type_index(const type_info &info) noexcept : m_info(&info) {}

    const char *name() const noexcept { return m_info->name(); }
    size_t hash_code() const noexcept { return m_info->hash_code(); }
    bool operator==(const type_index &other) const noexcept
    {
      return *m_info == *other.m_info;
    }
    bool operator!=(const type_index &other) const noexcept
    {
      return !(*this == other);
    }
    bool operator<(const type_index &other) const noexcept
    {
      return m_info->before(*other.m_info);
    }

  private:
    const type_info *m_info;
  };
}

#endif
