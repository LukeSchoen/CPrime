#ifndef _CPC_THREAD
#define _CPC_THREAD

#include <chrono>
#include <cprime_thread.h>
#include <utility>
#include <functional>
#include <stdexcept>

namespace std
{
  template<class... Args> struct __cpc_thread_arguments;
  template<> struct __cpc_thread_arguments<>
  {
    template<class Function, class... Bound>
    void invoke(Function &function, Bound... bound)
    { std::invoke(std::move(function), std::move(bound)...); }
  };
  template<class First, class... Rest>
  struct __cpc_thread_arguments<First, Rest...>
  {
    First first;
    __cpc_thread_arguments<Rest...> rest;
    template<class Value, class... Values>
    __cpc_thread_arguments(Value&& value, Values&&... values)
      : first(std::forward<Value>(value)), rest(std::forward<Values>(values)...) {}
    template<class Function, class... Bound>
    void invoke(Function &function, Bound&&... bound)
    { rest.invoke(function, std::forward<Bound>(bound)..., std::move(first)); }
  };

  template<class Function, class... Args> struct __cpc_thread_task
  {
    Function function;
    __cpc_thread_arguments<Args...> arguments;
    template<class Input, class... Values>
    __cpc_thread_task(Input&& input, Values&&... args)
      : function(std::forward<Input>(input)), arguments(std::forward<Values>(args)...) {}
    static void run(void *argument)
    {
      __cpc_thread_task *task = static_cast<__cpc_thread_task *>(argument);
      try { task->arguments.invoke(task->function); }
      catch (...) { delete task; std::terminate(); }
      delete task;
    }
  };

  class thread
  {
  public:
    typedef unsigned int id;
    typedef void *native_handle_type;
    thread() : m_thread(0) {}
    template<class Function, class... Args>
    explicit thread(Function &&function, Args&&... args) : m_thread(0)
    {
      typedef __cpc_thread_task<typename decay<Function>::type,
                               typename decay<Args>::type...> task_type;
      task_type *task = new task_type(std::forward<Function>(function),
                                     std::forward<Args>(args)...);
      m_thread = __cpc_windows_thread_create(&task_type::run, task);
      if (!m_thread) { delete task; throw runtime_error("could not create thread"); }
    }
    ~thread() { if (joinable()) std::terminate(); }
    thread(const thread &) = delete;
    thread &operator=(const thread &) = delete;
    thread(thread &&other) : m_thread(other.m_thread) { other.m_thread = 0; }
    thread &operator=(thread &&other)
    {
      if (joinable()) std::terminate();
      m_thread = other.m_thread; other.m_thread = 0;
      return *this;
    }
    bool joinable() const { return m_thread != 0; }
    void join()
    {
      if (!joinable() || get_id() == __cpc_windows_thread_id())
        throw runtime_error("thread cannot be joined");
      __cpc_windows_thread_join(m_thread); m_thread = 0;
    }
    void detach()
    {
      if (!joinable()) throw runtime_error("thread is not joinable");
      __cpc_windows_thread_detach(m_thread); m_thread = 0;
    }
    id get_id() const { return m_thread ? __cpc_windows_thread_handle_id(m_thread) : 0; }
    native_handle_type native_handle() { return m_thread; }
    static unsigned int hardware_concurrency()
    {
      return __cpc_windows_hardware_concurrency();
    }
  private:
    void *m_thread;
  };

  namespace this_thread
  {
    inline thread::id get_id() { return __cpc_windows_thread_id(); }
    inline void yield() { __cpc_windows_sleep_for_milliseconds(0); }
    template<typename Duration>
    inline void sleep_for(Duration duration)
    {
      __cpc_windows_sleep_for_milliseconds(duration.count());
    }
  }
}

#endif
