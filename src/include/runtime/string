#ifndef _CPC_STRING
#define _CPC_STRING
#include <iosfwd>
#include <memory>
#include <stdlib.h>
#include <string.h>
#include <wchar.h>
#include <stdio.h>
namespace std {
template<class C> struct char_traits {
  typedef C char_type;
  typedef unsigned long int_type;
  typedef streamoff off_type;
  typedef streamoff pos_type;
  static size_t length(const C* s) { size_t n = 0; while (s[n]) ++n; return n; }
  static void assign(C& a, const C& b) { a = b; }
  static C* assign(C* p, size_t n, C v) { for (size_t i=0;i<n;++i) p[i]=v; return p; }
  static C* copy(C* p, const C* s, size_t n) { if(n) memcpy(p,s,n*sizeof(C)); return p; }
  static C* move(C* p, const C* s, size_t n) { if(n) memmove(p,s,n*sizeof(C)); return p; }
  static bool eq(C a,C b) { return a==b; }
  static bool lt(C a,C b) { return a<b; }
  static int compare(const C* a,const C* b,size_t n) { for(size_t i=0;i<n;++i) { if(lt(a[i],b[i])) return -1; if(lt(b[i],a[i])) return 1; } return 0; }
  static const C* find(const C* s,size_t n,const C& c) { for(size_t i=0;i<n;++i) if(eq(s[i],c)) return s+i; return 0; }
  static int_type eof() { return (int_type)-1; }
  static bool eq_int_type(int_type a,int_type b) { return a==b; }
  static int_type to_int_type(C c) { return (int_type)c; }
  static C to_char_type(int_type c) { return (C)c; }
  static int_type not_eof(int_type c) { return c==eof()?0:c; }
};
template<class C, class Traits, class Alloc> class basic_string {
public:
  typedef C value_type;
  typedef Traits traits_type;
  typedef Alloc allocator_type;
  typedef size_t size_type;
  typedef ptrdiff_t difference_type;
  typedef C* iterator;
  typedef const C* const_iterator;
  static const size_t npos = (size_t)-1;
  basic_string() : m_data(0), m_len(0), m_capacity(0) {}
  basic_string(const C* s) : m_data(0), m_len(0), m_capacity(0) { assign(s,Traits::length(s)); }
  basic_string(const C* s,size_t n) : m_data(0), m_len(0), m_capacity(0) { assign(s,n); }
  basic_string(size_t n,C c) : m_data(0), m_len(0), m_capacity(0) { resize(n,c); }
  basic_string(const basic_string& s) : m_data(0), m_len(0), m_capacity(0) { assign(s.data(),s.size()); }
  basic_string(basic_string&& s) noexcept : m_data(s.m_data), m_len(s.m_len), m_capacity(s.m_capacity) { s.m_data=0; s.m_len=0; s.m_capacity=0; }
  ~basic_string() { if(m_data) Alloc().deallocate(m_data,m_capacity+1); }
  basic_string& operator=(const basic_string& s) { if(this!=&s) assign(s.data(),s.size()); return *this; }
  basic_string& operator=(C c) { return assign(&c,1); }
  basic_string& operator=(const C* s) { return assign(s,Traits::length(s)); }
  basic_string& operator=(basic_string&& s) noexcept { if(this!=&s) { if(m_data) Alloc().deallocate(m_data,m_capacity+1); m_data=s.m_data; m_len=s.m_len; m_capacity=s.m_capacity; s.m_data=0; s.m_len=0; s.m_capacity=0; } return *this; }
  void swap(basic_string& other) noexcept { std::swap(m_data,other.m_data);std::swap(m_len,other.m_len);std::swap(m_capacity,other.m_capacity); }
  size_t size() const { return m_len; }
  size_t length() const { return m_len; }
  size_t capacity() const { return m_capacity; }
  bool empty() const { return m_len==0; }
  const C* c_str() const { static const C zero[1] = {0}; return m_data?m_data:zero; }
  const C* data() const { return c_str(); }
  C* data() { if(!m_data) reserve(1); return m_data; }
  iterator begin() { return data(); }
  iterator end() { return data()+m_len; }
  const_iterator begin() const { return data(); }
  const_iterator end() const { return data()+m_len; }
  const_iterator cbegin() const { return begin(); }
  const_iterator cend() const { return end(); }
  C& front() { return data()[0]; }
  const C& front() const { return data()[0]; }
  C& back() { return data()[m_len-1]; }
  const C& back() const { return data()[m_len-1]; }
  C& operator[](size_t i) { return data()[i]; }
  const C& operator[](size_t i) const { return data()[i]; }
  void reserve(size_t n) {
    if(n<=m_capacity) return;
    if(n==(size_t)-1) throw std::bad_alloc();
    C* p=Alloc().allocate(n+1);
    Traits::copy(p,c_str(),m_len+1);
    if(m_data) Alloc().deallocate(m_data,m_capacity+1);
    m_data=p; m_capacity=n;
  }
  void resize(size_t n,C c=C()) { reserve(n); if(n>m_len) Traits::assign(m_data+m_len,n-m_len,c); m_len=n; if(m_data) m_data[n]=C(); }
  void clear() { m_len=0; if(m_data) m_data[0]=C(); }
  basic_string& assign(const C* s,size_t n) {
    // Copy before releasing the old buffer: s may point inside this string.
    C* p=Alloc().allocate(n+1); Traits::copy(p,s,n); p[n]=C();
    if(m_data) Alloc().deallocate(m_data,m_capacity+1);
    m_data=p; m_len=n; m_capacity=n; return *this;
  }
  template<class Iterator, typename enable_if<!is_integral<Iterator>::value,int>::type = 0>
  basic_string& assign(Iterator first,Iterator last) {
    basic_string incoming;
    for(;first!=last;++first) incoming.push_back(*first);
    swap(incoming);
    return *this;
  }
  basic_string& assign(const C* s) { return assign(s,Traits::length(s)); }
  basic_string& append(const C* s,size_t n) {
    if(n>(size_t)-1-m_len-1) throw std::bad_alloc();
    size_t total=m_len+n;
    C* p=Alloc().allocate(total+1); Traits::copy(p,c_str(),m_len); Traits::copy(p+m_len,s,n); p[total]=C();
    if(m_data) Alloc().deallocate(m_data,m_capacity+1);
    m_data=p; m_len=total; m_capacity=total; return *this;
  }
  basic_string& append(const C* s) { return append(s,Traits::length(s)); }
  basic_string& operator+=(const C* s) { return append(s); }
  basic_string& operator+=(const basic_string& s) { return append(s.data(),s.size()); }
  basic_string& operator+=(C c) { return append(&c,1); }
  void push_back(C c) { append(&c,1); }
  size_t find_first_of(C c,size_t pos=0) const { for(size_t i=pos;i<m_len;++i) if(Traits::eq(data()[i],c)) return i; return npos; }
  basic_string substr(size_t pos=0,size_t n=npos) const { if(pos>m_len) pos=m_len; if(n>m_len-pos) n=m_len-pos; return basic_string(data()+pos,n); }
  int compare(const basic_string& s) const { int c=Traits::compare(data(),s.data(),m_len<s.m_len?m_len:s.m_len); return c?c:(m_len<s.m_len?-1:m_len>s.m_len?1:0); }
private:
  C* m_data;
  size_t m_len;
  size_t m_capacity;
};
typedef basic_string<char> string;
typedef basic_string<wchar_t> wstring;
template<class C,class T,class A> bool operator==(const basic_string<C,T,A>& a,const basic_string<C,T,A>& b) { return a.compare(b)==0; }
template<class C,class T,class A> bool operator!=(const basic_string<C,T,A>& a,const basic_string<C,T,A>& b) { return a.compare(b)!=0; }
template<class C,class T,class A> bool operator<(const basic_string<C,T,A>& a,const basic_string<C,T,A>& b) { return a.compare(b)<0; }
template<class C,class T,class A> bool operator>(const basic_string<C,T,A>& a,const basic_string<C,T,A>& b) { return a.compare(b)>0; }
template<class C,class T,class A> bool operator<=(const basic_string<C,T,A>& a,const basic_string<C,T,A>& b) { return a.compare(b)<=0; }
template<class C,class T,class A> bool operator>=(const basic_string<C,T,A>& a,const basic_string<C,T,A>& b) { return a.compare(b)>=0; }
#define _CPC_STRING_POINTER_COMPARISON(op) \
template<class C,class T,class A> bool operator op(const basic_string<C,T,A>& a,const C* b) { return a.compare(basic_string<C,T,A>(b)) op 0; } \
template<class C,class T,class A> bool operator op(const C* a,const basic_string<C,T,A>& b) { return 0 op b.compare(basic_string<C,T,A>(a)); }
_CPC_STRING_POINTER_COMPARISON(==)
_CPC_STRING_POINTER_COMPARISON(!=)
_CPC_STRING_POINTER_COMPARISON(<)
_CPC_STRING_POINTER_COMPARISON(>)
_CPC_STRING_POINTER_COMPARISON(<=)
_CPC_STRING_POINTER_COMPARISON(>=)
#undef _CPC_STRING_POINTER_COMPARISON
template<class C,class T,class A> basic_string<C,T,A> operator+(basic_string<C,T,A> a,const basic_string<C,T,A>& b) { a+=b; return a; }
template<class C,class T,class A> basic_string<C,T,A> operator+(basic_string<C,T,A> a,C c) { a+=c; return a; }
template<class C,class T,class A> basic_string<C,T,A> operator+(basic_string<C,T,A> a,const C* b) { a+=b; return a; }
template<class C,class T,class A> basic_string<C,T,A> operator+(const C* a,const basic_string<C,T,A>& b) { basic_string<C,T,A> r(a); r+=b; return r; }
inline string to_string(int v) { char b[32]; snprintf(b,sizeof(b),"%d",v); return string(b); }
inline string to_string(unsigned int v) { char b[32]; snprintf(b,sizeof(b),"%u",v); return string(b); }
inline string to_string(long v) { char b[32]; snprintf(b,sizeof(b),"%ld",v); return string(b); }
inline string to_string(unsigned long v) { char b[32]; snprintf(b,sizeof(b),"%lu",v); return string(b); }
inline string to_string(long long v) { char b[32]; snprintf(b,sizeof(b),"%lld",v); return string(b); }
inline string to_string(unsigned long long v) { char b[32]; snprintf(b,sizeof(b),"%llu",v); return string(b); }
}
#endif
