  template<class InputIterator, class Size, class Function>
  InputIterator for_each_n(InputIterator first, Size count, Function function)
  {
    for (Size index = 0; index < count; ++index, ++first)
      function(*first);
    return first;
  }

  template<class ForwardIt1, class ForwardIt2>
  ForwardIt1 search(ForwardIt1 first, ForwardIt1 last,
                    ForwardIt2 pattern_first, ForwardIt2 pattern_last)
  {
    for (; ; ++first)
    {
      ForwardIt1 candidate = first;
      for (ForwardIt2 pattern = pattern_first; ; ++candidate, ++pattern)
      {
        if (pattern == pattern_last) return first;
        if (candidate == last) return last;
        if (!(*candidate == *pattern)) break;
      }
    }
  }

  /* The C++17 searcher form: the searcher owns the pattern and answers the
     search over one range. */
  template<class ForwardIt, class Searcher>
  ForwardIt search(ForwardIt first, ForwardIt last, const Searcher &searcher)
  {
    return searcher(first, last);
  }

  template<class BidirectionalIterator>
  void reverse(BidirectionalIterator first, BidirectionalIterator last)
  {
    while(first!=last){--last;if(first==last)break;std::swap(*first,*last);++first;}
  }
  template<class InputIt, class T>
  InputIt find(InputIt first, InputIt last, const T &value)
  {
    for (; first != last; ++first) if (*first == value) break;
    return first;
  }
  template<class InputIt, class Predicate>
  InputIt find_if(InputIt first, InputIt last, Predicate predicate)
  {
    for (; first != last; ++first) if (predicate(*first)) break;
    return first;
  }
  template<class ForwardIterator, class BinaryPredicate>
  ForwardIterator unique(ForwardIterator first, ForwardIterator last,
                         BinaryPredicate equal)
  {
    if (first == last) return last;
    ForwardIterator result = first;
    while (++first != last)
      if (!equal(*result, *first))
      {
        ++result;
        if (result != first) *result = std::move(*first);
      }
    return ++result;
  }

  template<class ForwardIterator>
  ForwardIterator unique(ForwardIterator first, ForwardIterator last)
  {
    if (first == last) return last;
    ForwardIterator result = first;
    while (++first != last)
      if (!(*result == *first))
      {
        ++result;
        if (result != first) *result = std::move(*first);
      }
    return ++result;
  }

  template<class ForwardIt, class T>
  void fill(ForwardIt first, ForwardIt last, const T &value)
  {
    for (; first != last; ++first)
      *first = value;
  }

  template<class T>
  const T &min(const T &left, const T &right)
  {
    return right < left ? right : left;
  }

  template<class T>
  const T &max(const T &left, const T &right)
  {
    return left < right ? right : left;
  }

  template<class T>
  constexpr const T &clamp(const T &value, const T &low, const T &high)
  {
    return value < low ? low : high < value ? high : value;
  }

  template<class T, class Compare>
  constexpr const T &clamp(const T &value, const T &low, const T &high,
                           Compare compare)
  {
    return compare(value, low) ? low : compare(high, value) ? high : value;
  }

  template<class T>
  void iter_swap(T *left, T *right)
  {
    T value = *left;
    *left = *right;
    *right = value;
  }

  template<class T>
  void sort(T *begin, T *end)
  {
    for (T *current = begin + 1; current < end; ++current)
    {
      T *position = current;
      while (position > begin && *position < *(position - 1))
      {
        T value = *position;
        *position = *(position - 1);
        *(position - 1) = value;
        --position;
      }
    }
  }

  template<class T, class Compare>
  void sort(T *begin, T *end, Compare compare)
  {
    for (T *current = begin + 1; current < end; ++current)
    {
      T *position = current;
      while (position > begin && compare(*position, *(position - 1)))
      {
        T value = *position;
        *position = *(position - 1);
        *(position - 1) = value;
        --position;
      }
    }
  }

  template<class Iterator, class T>
  Iterator lower_bound(Iterator begin, Iterator end, const T &value)
  {
    while (begin < end)
    {
      Iterator middle = begin + (end - begin) / 2;
      if (*middle < value) begin = middle + 1;
      else end = middle;
    }
    return begin;
  }

  template<class Iterator, class T>
  Iterator upper_bound(Iterator begin, Iterator end, const T &value)
  {
    while (begin < end)
    {
      Iterator middle = begin + (end - begin) / 2;
      if (!(value < *middle)) begin = middle + 1;
      else end = middle;
    }
    return begin;
  }

  template<class T>
  void replace(T *begin, T *end, const T &old_value, const T &new_value)
  {
    for (; begin != end; ++begin)
      if (*begin == old_value) *begin = new_value;
  }

  template<class T>
  void shuffle(T *begin, T *end)
  {
    for (T *current = end; current - begin > 1; --current)
    {
      T *other = begin + (rand() % (current - begin));
      T value = *(current - 1);
      *(current - 1) = *other;
      *other = value;
    }
  }
  /* The C++11 form takes the uniform random bit generator: the swap index
     comes from the generator scaled into the remaining range. */
  template<class RandomIt, class URBG>
  void shuffle(RandomIt first, RandomIt last, URBG &&generator)
  {
    typedef typename iterator_traits<RandomIt>::difference_type difference;
    difference remaining = last - first;
    while (remaining > 1)
    {
      difference offset = (difference)(generator() % (unsigned long long)remaining);
      --remaining;
      if (offset != remaining)
      {
        RandomIt other = first + offset;
        RandomIt current = first + remaining;
        typename iterator_traits<RandomIt>::value_type value = *current;
        *current = *other;
        *other = value;
      }
    }
  }
  template<class Input,class Output,class Operation>
  Output transform(Input first,Input last,Output result,Operation operation) {
    for(;first!=last;++first,++result) *result=operation(*first);
    return result;
  }
  template<class Input1,class Input2,class Output,class Operation>
  Output transform(Input1 first,Input1 last,Input2 second,Output result,Operation operation) {
    for(;first!=last;++first,++second,++result) *result=operation(*first,*second);
    return result;
  }
  struct __heap_less {
    template<class T, class U> bool operator()(T&& a,U&& b) const {return std::forward<T>(a)<std::forward<U>(b);}
  };
  template<class Iterator,class Compare>
  void push_heap(Iterator first,Iterator last,Compare compare) {
    auto count=last-first;
    if(count<2)return;
    auto child=count-1;
    while(child>0) {
      auto parent=(child-1)/2;
      if(!compare(first[parent],first[child]))break;
      std::swap(first[parent],first[child]);
      child=parent;
    }
  }
  template<class Iterator> void push_heap(Iterator first,Iterator last) {
    std::push_heap(first,last,__heap_less{});
  }
  template<class Iterator,class Compare>
  void __heap_sift_down(Iterator first,typename iterator_traits<Iterator>::difference_type count,
                        typename iterator_traits<Iterator>::difference_type parent,Compare compare) {
    for(;;) {
      auto child=parent*2+1;
      if(child>=count)return;
      if(child+1<count && compare(first[child],first[child+1]))++child;
      if(!compare(first[parent],first[child]))return;
      std::swap(first[parent],first[child]);
      parent=child;
    }
  }
  template<class Iterator,class Compare>
  void pop_heap(Iterator first,Iterator last,Compare compare) {
    auto count=last-first;
    if(count<2)return;
    std::swap(*first,*(last-1));
    std::__heap_sift_down(first,count-1,decltype(count)(0),compare);
  }
  template<class Iterator> void pop_heap(Iterator first,Iterator last) {
    std::pop_heap(first,last,__heap_less{});
  }
  template<class Iterator,class Compare>
  void make_heap(Iterator first,Iterator last,Compare compare) {
    auto count=last-first;
    for(auto parent=count/2;parent>0;)
      std::__heap_sift_down(first,count,--parent,compare);
  }
  template<class Iterator> void make_heap(Iterator first,Iterator last) {
    std::make_heap(first,last,__heap_less{});
  }
  template<class Iterator,class Compare>
  void sort_heap(Iterator first,Iterator last,Compare compare) {
    while(last-first>1)std::pop_heap(first,last--,compare);
  }
  template<class Iterator> void sort_heap(Iterator first,Iterator last) {
    std::sort_heap(first,last,__heap_less{});
  }
  template<class Iterator,class Compare>
  Iterator is_heap_until(Iterator first,Iterator last,Compare compare) {
    auto count=last-first;
    for(decltype(count) child=1;child<count;++child)
      if(compare(first[(child-1)/2],first[child]))return first+child;
    return last;
  }
  template<class Iterator> Iterator is_heap_until(Iterator first,Iterator last) {
    return std::is_heap_until(first,last,__heap_less{});
  }
  template<class Iterator,class Compare>
  bool is_heap(Iterator first,Iterator last,Compare compare) {
    return std::is_heap_until(first,last,compare)==last;
  }
  template<class Iterator> bool is_heap(Iterator first,Iterator last) {
    return std::is_heap(first,last,__heap_less{});
  }

}

#endif
