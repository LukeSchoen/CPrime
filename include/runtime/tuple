#ifndef _CPC_TUPLE
#define _CPC_TUPLE

#include <stddef.h>
#include <type_traits>
#include <utility>

namespace std
{
  /* One storage slot per element. Reference elements bind instead of storing,
     so a tuple of references shares its referents. */
  template<size_t Index, class T>
  struct __tuple_leaf
  {
    T __value;
    __tuple_leaf() : __value() {}
    template<class U>
    explicit __tuple_leaf(U &&value) : __value(std::forward<U>(value)) {}
  };

  template<size_t Index, class... Types>
  struct __tuple_impl;

  template<size_t Index>
  struct __tuple_impl<Index>
  {
    __tuple_impl() {}
    template<class... Values>
    explicit __tuple_impl(Values &&...) {}
  };

  template<size_t Index, class First, class... Rest>
  struct __tuple_impl<Index, First, Rest...>
    : __tuple_leaf<Index, First>, __tuple_impl<Index + 1, Rest...>
  {
    typedef __tuple_leaf<Index, First> __head;
    typedef __tuple_impl<Index + 1, Rest...> __tail;

    __tuple_impl() : __head(), __tail() {}
    __tuple_impl(const __tuple_impl &) = default;
    __tuple_impl(__tuple_impl &&) = default;

    template<class U, class... Values>
    explicit __tuple_impl(U &&value, Values &&...rest)
      : __head(std::forward<U>(value)), __tail(std::forward<Values>(rest)...) {}
  };

  template<class... Types>
  class tuple : public __tuple_impl<0, Types...>
  {
    typedef __tuple_impl<0, Types...> __base;
  public:
    tuple() : __base() {}
    tuple(const tuple &) = default;
    tuple(tuple &&) = default;
    tuple &operator=(const tuple &) = default;
    tuple &operator=(tuple &&) = default;

    template<class... Values>
    explicit tuple(Values &&...values)
      : __base(std::forward<Values>(values)...) {}
  };

  template<class T>
  struct tuple_size;
  template<class... Types>
  struct tuple_size<tuple<Types...> >
  {
    static const size_t value = sizeof...(Types);
    typedef size_t value_type;
  };
  template<class T>
  struct tuple_size<const T> : tuple_size<T> {};
  template<class T>
  struct tuple_size<volatile T> : tuple_size<T> {};

  template<size_t Index, class T>
  struct tuple_element;
  template<class First, class... Rest>
  struct tuple_element<0, tuple<First, Rest...> >
  {
    typedef First type;
  };
  template<size_t Index, class First, class... Rest>
  struct tuple_element<Index, tuple<First, Rest...> >
  {
    typedef typename tuple_element<Index - 1, tuple<Rest...> >::type type;
  };
  template<size_t Index, class T>
  struct tuple_element<Index, const T>
  {
    typedef const typename tuple_element<Index, T>::type type;
  };

  /* The receiver is deduced as a whole instead of opening the class's pack:
     a pack expansion nested in a function parameter type (`tuple<Ts...>`) is
     not a deduced context for this compiler, while `tuple_element` resolves
     the index inside the class specialization. */
  template<size_t Index, class Tuple>
  typename tuple_element<Index, Tuple>::type &get(Tuple &value)
  {
    typedef typename tuple_element<Index, Tuple>::type type;
    return static_cast<__tuple_leaf<Index, type> &>(value).__value;
  }

  template<size_t Index, class Tuple>
  const typename tuple_element<Index, Tuple>::type &get(const Tuple &value)
  {
    typedef typename tuple_element<Index, Tuple>::type type;
    return static_cast<const __tuple_leaf<Index, type> &>(value).__value;
  }

  /* make_tuple and tie name their parameters explicitly: a pack expansion
     written inside a function's template-id (`tuple<decay<Ts>::type...>`) is
     not part of the compiler's function-template substitution path yet. */
  template<class T1>
  tuple<typename decay<T1>::type>
  make_tuple(T1 &&a)
  {
    typedef tuple<typename decay<T1>::type> result_type;
    return result_type(std::forward<T1>(a));
  }

  template<class T1, class T2>
  tuple<typename decay<T1>::type, typename decay<T2>::type>
  make_tuple(T1 &&a, T2 &&b)
  {
    typedef tuple<typename decay<T1>::type, typename decay<T2>::type> result_type;
    return result_type(std::forward<T1>(a), std::forward<T2>(b));
  }

  template<class T1, class T2, class T3>
  tuple<typename decay<T1>::type, typename decay<T2>::type,
        typename decay<T3>::type>
  make_tuple(T1 &&a, T2 &&b, T3 &&c)
  {
    typedef tuple<typename decay<T1>::type, typename decay<T2>::type,
                  typename decay<T3>::type> result_type;
    return result_type(std::forward<T1>(a), std::forward<T2>(b),
                       std::forward<T3>(c));
  }

  template<class T1, class T2, class T3, class T4>
  tuple<typename decay<T1>::type, typename decay<T2>::type,
        typename decay<T3>::type, typename decay<T4>::type>
  make_tuple(T1 &&a, T2 &&b, T3 &&c, T4 &&d)
  {
    typedef tuple<typename decay<T1>::type, typename decay<T2>::type,
                  typename decay<T3>::type, typename decay<T4>::type>
        result_type;
    return result_type(std::forward<T1>(a), std::forward<T2>(b),
                       std::forward<T3>(c), std::forward<T4>(d));
  }

  template<class T1, class T2, class T3, class T4, class T5>
  tuple<typename decay<T1>::type, typename decay<T2>::type,
        typename decay<T3>::type, typename decay<T4>::type,
        typename decay<T5>::type>
  make_tuple(T1 &&a, T2 &&b, T3 &&c, T4 &&d, T5 &&e)
  {
    typedef tuple<typename decay<T1>::type, typename decay<T2>::type,
                  typename decay<T3>::type, typename decay<T4>::type,
                  typename decay<T5>::type> result_type;
    return result_type(std::forward<T1>(a), std::forward<T2>(b),
                       std::forward<T3>(c), std::forward<T4>(d),
                       std::forward<T5>(e));
  }

  template<class T1, class T2, class T3, class T4, class T5, class T6>
  tuple<typename decay<T1>::type, typename decay<T2>::type,
        typename decay<T3>::type, typename decay<T4>::type,
        typename decay<T5>::type, typename decay<T6>::type>
  make_tuple(T1 &&a, T2 &&b, T3 &&c, T4 &&d, T5 &&e, T6 &&f)
  {
    typedef tuple<typename decay<T1>::type, typename decay<T2>::type,
                  typename decay<T3>::type, typename decay<T4>::type,
                  typename decay<T5>::type, typename decay<T6>::type>
        result_type;
    return result_type(std::forward<T1>(a), std::forward<T2>(b),
                       std::forward<T3>(c), std::forward<T4>(d),
                       std::forward<T5>(e), std::forward<T6>(f));
  }

  template<class T1>
  tuple<T1 &> tie(T1 &a)
  {
    return tuple<T1 &>(a);
  }

  template<class T1, class T2>
  tuple<T1 &, T2 &> tie(T1 &a, T2 &b)
  {
    return tuple<T1 &, T2 &>(a, b);
  }

  template<class T1, class T2, class T3>
  tuple<T1 &, T2 &, T3 &> tie(T1 &a, T2 &b, T3 &c)
  {
    return tuple<T1 &, T2 &, T3 &>(a, b, c);
  }

  template<class T1, class T2, class T3, class T4>
  tuple<T1 &, T2 &, T3 &, T4 &> tie(T1 &a, T2 &b, T3 &c, T4 &d)
  {
    return tuple<T1 &, T2 &, T3 &, T4 &>(a, b, c, d);
  }

  /* apply expands the element list over an index sequence. That needs a pack
     expansion inside `index_sequence<Indices...>`, which this compiler does
     not accept in a function parameter, so each arity is written out. */
  template<class Function, class T1>
  auto apply(Function &&function, tuple<T1> &arguments)
    -> decltype(function(std::get<0>(arguments)))
  {
    return function(std::get<0>(arguments));
  }

  template<class Function, class T1, class T2>
  auto apply(Function &&function, tuple<T1, T2> &arguments)
    -> decltype(function(std::get<0>(arguments), std::get<1>(arguments)))
  {
    return function(std::get<0>(arguments), std::get<1>(arguments));
  }

  template<class Function, class T1, class T2, class T3>
  auto apply(Function &&function, tuple<T1, T2, T3> &arguments)
    -> decltype(function(std::get<0>(arguments), std::get<1>(arguments),
                         std::get<2>(arguments)))
  {
    return function(std::get<0>(arguments), std::get<1>(arguments),
                    std::get<2>(arguments));
  }

  template<class Function, class T1, class T2, class T3, class T4>
  auto apply(Function &&function, tuple<T1, T2, T3, T4> &arguments)
    -> decltype(function(std::get<0>(arguments), std::get<1>(arguments),
                         std::get<2>(arguments), std::get<3>(arguments)))
  {
    return function(std::get<0>(arguments), std::get<1>(arguments),
                    std::get<2>(arguments), std::get<3>(arguments));
  }

  template<class Function, class T1, class T2, class T3, class T4, class T5>
  auto apply(Function &&function, tuple<T1, T2, T3, T4, T5> &arguments)
    -> decltype(function(std::get<0>(arguments), std::get<1>(arguments),
                         std::get<2>(arguments), std::get<3>(arguments),
                         std::get<4>(arguments)))
  {
    return function(std::get<0>(arguments), std::get<1>(arguments),
                    std::get<2>(arguments), std::get<3>(arguments),
                    std::get<4>(arguments));
  }

  template<class Function, class T1, class T2, class T3, class T4, class T5,
           class T6>
  auto apply(Function &&function, tuple<T1, T2, T3, T4, T5, T6> &arguments)
    -> decltype(function(std::get<0>(arguments), std::get<1>(arguments),
                         std::get<2>(arguments), std::get<3>(arguments),
                         std::get<4>(arguments), std::get<5>(arguments)))
  {
    return function(std::get<0>(arguments), std::get<1>(arguments),
                    std::get<2>(arguments), std::get<3>(arguments),
                    std::get<4>(arguments), std::get<5>(arguments));
  }

  template<class Function, class T1, class T2>
  auto apply(Function &&function, const tuple<T1, T2> &arguments)
    -> decltype(function(std::get<0>(arguments), std::get<1>(arguments)))
  {
    return function(std::get<0>(arguments), std::get<1>(arguments));
  }

  template<class Function, class T1, class T2, class T3>
  auto apply(Function &&function, const tuple<T1, T2, T3> &arguments)
    -> decltype(function(std::get<0>(arguments), std::get<1>(arguments),
                         std::get<2>(arguments)))
  {
    return function(std::get<0>(arguments), std::get<1>(arguments),
                    std::get<2>(arguments));
  }

  template<class Function, class T1, class T2>
  auto apply(Function &&function, pair<T1, T2> &arguments)
    -> decltype(std::forward<Function>(function)(arguments.first,
                                                 arguments.second))
  {
    return std::forward<Function>(function)(arguments.first, arguments.second);
  }

  template<class Function, class T1, class T2>
  auto apply(Function &&function, const pair<T1, T2> &arguments)
    -> decltype(std::forward<Function>(function)(arguments.first,
                                                 arguments.second))
  {
    return std::forward<Function>(function)(arguments.first, arguments.second);
  }
}

#endif
