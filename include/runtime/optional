#ifndef _CPC_OPTIONAL
#define _CPC_OPTIONAL

#include <utility>
#include <new>
#include <type_traits>

namespace std
{
  struct nullopt_t
  {
    explicit constexpr nullopt_t(int) {}
  };

  constexpr nullopt_t nullopt(0);

  class bad_optional_access : public exception
  {
  public:
    const char *what() const noexcept override { return "bad optional access"; }
  };

  template<class T>
  struct __optional_storage_union
  {
    union Value
    {
      char empty;
      T value;
      constexpr Value() noexcept : empty() {}
      ~Value() {}
    } data;

    constexpr __optional_storage_union() noexcept : data() {}
    ~__optional_storage_union() {}
  };

  template<class T, bool>
  struct __optional_storage;

  template<class T>
  struct __optional_storage<T, true>
  {
    __optional_storage_union<T> data;
    bool engaged;

    constexpr __optional_storage() noexcept : data(), engaged(false) {}
    ~__optional_storage() {}
    __optional_storage(const __optional_storage &other) : data(), engaged(false)
    {
      if (other.engaged) {
        ::new (static_cast<void *>(&data.data.value)) T(other.data.data.value);
        engaged = true;
      }
    }
    __optional_storage(__optional_storage &&other) : data(), engaged(false)
    {
      if (other.engaged) {
        ::new (static_cast<void *>(&data.data.value))
            T(static_cast<T &&>(other.data.data.value));
        engaged = true;
      }
    }
  };

  template<class T>
  struct __optional_storage<T, false>
  {
    __optional_storage_union<T> data;
    bool engaged;

    constexpr __optional_storage() noexcept : data(), engaged(false) {}
    ~__optional_storage() {}
    __optional_storage(const __optional_storage &) = delete;
    __optional_storage(__optional_storage &&other) : data(), engaged(false)
    {
      if (other.engaged) {
        ::new (static_cast<void *>(&data.data.value))
            T(static_cast<T &&>(other.data.data.value));
        engaged = true;
      }
    }
  };

  template<class T>
  class optional
  {
  public:
    typedef T value_type;

    constexpr optional() noexcept : m_storage() {}
    constexpr optional(nullopt_t) noexcept : m_storage() {}
    constexpr optional(const T &value) : m_storage()
    {
      ::new (static_cast<void *>(&m_storage.data.data.value)) T(value);
      m_storage.engaged = true;
    }
    constexpr optional(T &&value) : m_storage()
    {
      ::new (static_cast<void *>(&m_storage.data.data.value))
          T(static_cast<T &&>(value));
      m_storage.engaged = true;
    }
    optional(const optional &) = default;
    optional(optional &&) = default;
    ~optional() { reset(); }

    optional &operator=(const optional &other)
    {
      if (other.m_storage.engaged) *this = other.m_storage.data.data.value;
      else reset();
      return *this;
    }

    optional &operator=(optional &&other)
    {
      if (other.m_storage.engaged)
        *this = static_cast<T &&>(other.m_storage.data.data.value);
      else reset();
      return *this;
    }

    optional &operator=(nullopt_t)
    {
      reset();
      return *this;
    }

    optional &operator=(const T &value)
    {
      if (m_storage.engaged) m_storage.data.data.value = value;
      else emplace(value);
      return *this;
    }

    optional &operator=(T &&value)
    {
      if (m_storage.engaged)
        m_storage.data.data.value = static_cast<T &&>(value);
      else emplace(static_cast<T &&>(value));
      return *this;
    }

    constexpr bool has_value() const { return m_storage.engaged; }
    constexpr explicit operator bool() const { return m_storage.engaged; }

    constexpr T &value() { if (!m_storage.engaged) throw bad_optional_access(); return m_storage.data.data.value; }
    constexpr const T &value() const { if (!m_storage.engaged) throw bad_optional_access(); return m_storage.data.data.value; }
    template<class U>
    T value_or(U &&fallback) const
    {
      return m_storage.engaged ? m_storage.data.data.value
                       : static_cast<T>(std::forward<U>(fallback));
    }
    constexpr T &operator*() { return m_storage.data.data.value; }
    constexpr const T &operator*() const { return m_storage.data.data.value; }
    T *operator->() { return &m_storage.data.data.value; }
    const T *operator->() const { return &m_storage.data.data.value; }

    constexpr void reset() noexcept
    {
      if (m_storage.engaged) {
        m_storage.data.data.value.~T();
        m_storage.engaged = false;
      }
    }

    template<class... Args>
    T &emplace(Args &&...args)
    {
      reset();
      ::new (static_cast<void *>(&m_storage.data.data.value))
          T(static_cast<Args &&>(args)...);
      m_storage.engaged = true;
      return m_storage.data.data.value;
    }

  private:
    __optional_storage<T, __is_copy_constructible<T>::value> m_storage;
  };

  /* C++17 comparisons.  Engaged optionals compare their values; a disengaged
     optional is less than every engaged one and equal only to another
     disengaged optional. */
  template<class T, class U>
  constexpr bool operator==(const optional<T> &left, const optional<U> &right)
  {
    if (left.has_value() != right.has_value()) return false;
    return !left.has_value() || *left == *right;
  }
  template<class T, class U>
  constexpr bool operator!=(const optional<T> &left, const optional<U> &right)
  {
    return !(left == right);
  }
  template<class T, class U>
  constexpr bool operator<(const optional<T> &left, const optional<U> &right)
  {
    if (!right.has_value()) return false;
    if (!left.has_value()) return true;
    return *left < *right;
  }
  template<class T, class U>
  constexpr bool operator>(const optional<T> &left, const optional<U> &right)
  {
    return right < left;
  }
  template<class T, class U>
  constexpr bool operator<=(const optional<T> &left, const optional<U> &right)
  {
    return !(right < left);
  }
  template<class T, class U>
  constexpr bool operator>=(const optional<T> &left, const optional<U> &right)
  {
    return !(left < right);
  }

  /* The nullopt comparisons below are the only candidates for a nullopt_t
     operand: overload resolution here does not order a value template
     against that non-template-parameter type, so the value forms exclude it
     explicitly. */
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator==(const optional<T> &left, const U &right)
  {
    return left.has_value() && *left == right;
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator==(const U &left, const optional<T> &right)
  {
    return right.has_value() && left == *right;
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator!=(const optional<T> &left, const U &right)
  {
    return !left.has_value() || !(*left == right);
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator!=(const U &left, const optional<T> &right)
  {
    return !right.has_value() || !(left == *right);
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator<(const optional<T> &left, const U &right)
  {
    return !left.has_value() || *left < right;
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator<(const U &left, const optional<T> &right)
  {
    return right.has_value() && left < *right;
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator>(const optional<T> &left, const U &right)
  {
    return left.has_value() && right < *left;
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator>(const U &left, const optional<T> &right)
  {
    return !right.has_value() || *right < left;
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator<=(const optional<T> &left, const U &right)
  {
    return !left.has_value() || !(right < *left);
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator<=(const U &left, const optional<T> &right)
  {
    return right.has_value() && !(left > *right);
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator>=(const optional<T> &left, const U &right)
  {
    return left.has_value() && !(*left < right);
  }
  template<class T, class U,
           typename enable_if<!is_same<U, nullopt_t>::value, int>::type = 0>
  constexpr bool operator>=(const U &left, const optional<T> &right)
  {
    return !right.has_value() || !(left < *right);
  }

  template<class T>
  constexpr bool operator==(const optional<T> &left, nullopt_t)
  {
    return !left.has_value();
  }
  template<class T>
  constexpr bool operator==(nullopt_t, const optional<T> &right)
  {
    return !right.has_value();
  }
  template<class T>
  constexpr bool operator!=(const optional<T> &left, nullopt_t)
  {
    return left.has_value();
  }
  template<class T>
  constexpr bool operator!=(nullopt_t, const optional<T> &right)
  {
    return right.has_value();
  }
  template<class T>
  constexpr bool operator<(const optional<T> &, nullopt_t)
  {
    return false;
  }
  template<class T>
  constexpr bool operator<(nullopt_t, const optional<T> &right)
  {
    return right.has_value();
  }
  template<class T>
  constexpr bool operator>(const optional<T> &left, nullopt_t)
  {
    return left.has_value();
  }
  template<class T>
  constexpr bool operator>(nullopt_t, const optional<T> &)
  {
    return false;
  }
  template<class T>
  constexpr bool operator<=(const optional<T> &left, nullopt_t)
  {
    return !left.has_value();
  }
  template<class T>
  constexpr bool operator<=(nullopt_t, const optional<T> &)
  {
    return true;
  }
  template<class T>
  constexpr bool operator>=(const optional<T> &, nullopt_t)
  {
    return true;
  }
  template<class T>
  constexpr bool operator>=(nullopt_t, const optional<T> &right)
  {
    return !right.has_value();
  }
}

#endif
