#ifndef _CPC_LOCALE
#define _CPC_LOCALE

#include <cctype>
#include <cwchar>
#include <stddef.h>
#include <string.h>

namespace std
{
  /* A locale owns a small fixed registry of facets. The registration call
     knows the facet's static type, so the entry stores the type name next to
     the facet and lookup does not depend on a per-type static object being
     merged across translation units. */
  class locale
  {
  public:
    class id;
    class facet;

    locale() : m_count(0)
    {
      add(new ctype<char>(), facet_name<ctype<char> >());
      add(new ctype<wchar_t>(), facet_name<ctype<wchar_t> >());
    }

    locale(const locale& other) : m_count(0) { acquire(other); }

    template<class Facet>
    locale(const locale& other, Facet* value) : m_count(0)
    {
      acquire(other);
      if (value)
      {
        value->_Incref();
        insert(value, facet_name<Facet>());
      }
    }

    ~locale() { release(); }

    locale& operator=(const locale& other)
    {
      if (this != &other)
      {
        release();
        acquire(other);
      }
      return *this;
    }

    template<class Facet>
    bool has() const
    {
      return find(facet_name<Facet>()) != 0;
    }

    template<class Facet>
    const Facet* lookup() const
    {
      facet* found = find(facet_name<Facet>());
      return found ? static_cast<const Facet*>(found) : 0;
    }

  private:
    static const int capacity = 16;

    void add(facet* value, const char* name)
    {
      if (m_count < capacity)
      {
        m_facets[m_count] = value;
        m_names[m_count] = name;
        ++m_count;
      }
      else
      {
        value->_Decref();
      }
    }

    void acquire(const locale& other)
    {
      for (int i = 0; i < other.m_count; ++i)
      {
        other.m_facets[i]->_Incref();
        m_facets[m_count] = other.m_facets[i];
        m_names[m_count] = other.m_names[i];
        ++m_count;
      }
    }

    void release()
    {
      for (int i = 0; i < m_count; ++i)
        m_facets[i]->_Decref();
      m_count = 0;
    }

    void insert(facet* value, const char* name)
    {
      facet* previous = find(name);
      if (previous)
      {
        for (int i = 0; i < m_count; ++i)
          if (m_facets[i] == previous)
          {
            m_facets[i] = value;
            m_names[i] = name;
          }
        previous->_Decref();
      }
      else
      {
        add(value, name);
      }
    }

    facet* find(const char* name) const
    {
      for (int i = 0; i < m_count; ++i)
        if (strcmp(m_names[i], name) == 0)
          return m_facets[i];
      return 0;
    }

    template<class Facet>
    static const char* facet_name()
    {
      const char* signature = __PRETTY_FUNCTION__;
      const char* opening = strstr(signature, "[with F = ");
      if (!opening)
        return signature;
      opening += 10;
      const char* closing = strchr(opening, ']');
      if (!closing)
        return opening;
      return intern(opening, (size_t)(closing - opening));
    }

    static const char* intern(const char* text, size_t length)
    {
      static char buffer[256];
      if (length >= sizeof(buffer))
        return text;
      memcpy(buffer, text, length);
      buffer[length] = 0;
      return buffer;
    }

    int m_count;
    facet* m_facets[capacity];
    const char* m_names[capacity];
  };

  class locale::id
  {
  public:
    id() : m_index(0) {}

    size_t operator()() const
    {
      static size_t next = 0;
      if (!m_index)
        m_index = ++next;
      return m_index;
    }

  private:
    id(const id&);
    void operator=(const id&);
    mutable size_t m_index;
  };

  class locale::facet
  {
    friend class locale;
  public:
    static locale::id id;

    explicit facet(size_t refs = 0) : m_refs(refs < 1 ? 1 : refs) {}
    virtual ~facet() {}

  protected:
    virtual void _Incref() { ++m_refs; }

    virtual void _Decref()
    {
      if (--m_refs <= 0)
        delete this;
    }

  private:
    facet(const facet&);
    void operator=(const facet&);

    size_t m_refs;
  };

  class ctype_base : public locale::facet
  {
  public:
    ctype_base() : locale::facet(0) {}

    enum mask
    {
      space = 0x0001,
      print = 0x0002,
      cntrl = 0x0004,
      upper = 0x0008,
      lower = 0x0010,
      alpha = 0x0020,
      digit = 0x0040,
      punct = 0x0080,
      xdigit = 0x0100,
      blank = 0x0200,
      alnum = alpha | digit,
      graph = print | punct
    };
  };

  template<class CharT>
  class ctype : public ctype_base
  {
  public:
    ctype() : ctype_base() {}

    bool is(mask m, CharT c) const
    {
      unsigned char value = (unsigned char)c;
      return ((m & space) && isspace(value))
          || ((m & print) && isprint(value))
          || ((m & cntrl) && iscntrl(value))
          || ((m & upper) && isupper(value))
          || ((m & lower) && islower(value))
          || ((m & alpha) && isalpha(value))
          || ((m & digit) && isdigit(value))
          || ((m & punct) && ispunct(value))
          || ((m & xdigit) && isxdigit(value))
          || ((m & blank) && (value == ' ' || value == '\t'));
    }

    CharT toupper(CharT c) const
    {
      return (CharT)::toupper((unsigned char)c);
    }

    CharT tolower(CharT c) const
    {
      return (CharT)::tolower((unsigned char)c);
    }
  };

  template<class Facet>
  const Facet& use_facet(const locale& location)
  {
    const Facet* found = location.lookup<Facet>();
    if (found)
      return *found;
    static const Facet fallback;
    return fallback;
  }

  template<class Facet>
  bool has_facet(const locale& location)
  {
    return location.has<Facet>();
  }

  template<class CharT>
  CharT toupper(CharT c, const locale& loc)
  {
    return use_facet<ctype<CharT> >(loc).toupper(c);
  }

  template<class CharT>
  CharT tolower(CharT c, const locale& loc)
  {
    return use_facet<ctype<CharT> >(loc).tolower(c);
  }
}

#endif
