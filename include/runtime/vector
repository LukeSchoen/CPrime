#ifndef _CPC_VECTOR
#define _CPC_VECTOR

#include <stddef.h>
#include <stdlib.h>
#include <new>
#include <type_traits>
#include <utility>
#include <stdexcept>

namespace std
{
  template<typename T>
  class vector
  {
  public:
    typedef T value_type;
    typedef size_t size_type;
    typedef T *iterator;
    typedef const T *const_iterator;

    vector() : m_data(0), m_size(0), m_capacity(0) {}

    explicit vector(size_t count) : vector() { resize(count); }
    vector(size_t count, const T &value) : vector() { resize(count, value); }

    template<class InputIterator,
      class = typename enable_if<!is_integral<InputIterator>::value>::type>
    vector(InputIterator first, InputIterator last) : vector()
    {
      for (; first != last; ++first)
        push_back(*first);
    }

    vector(const vector &other) : vector()
    {
      reserve(other.m_size);
      for (size_t i = 0; i < other.m_size; ++i)
        push_back(other.m_data[i]);
    }

    vector(vector &&other) noexcept
      : m_data(other.m_data), m_size(other.m_size), m_capacity(other.m_capacity)
    {
      other.m_data = 0;
      other.m_size = other.m_capacity = 0;
    }

    ~vector() { clear(); free(m_data); }

    vector &operator=(const vector &other)
    {
      if (this != &other)
      {
        vector copy(other);
        swap(copy);
      }
      return *this;
    }

    vector &operator=(vector &&other) noexcept
    {
      if (this != &other)
      {
        clear();
        free(m_data);
        m_data = other.m_data;
        m_size = other.m_size;
        m_capacity = other.m_capacity;
        other.m_data = 0;
        other.m_size = other.m_capacity = 0;
      }
      return *this;
    }

    void swap(vector &other) noexcept
    {
      T *data = m_data; m_data = other.m_data; other.m_data = data;
      size_t size = m_size; m_size = other.m_size; other.m_size = size;
      size_t capacity = m_capacity; m_capacity = other.m_capacity;
      other.m_capacity = capacity;
    }

    T &operator[](size_t index) { return m_data[index]; }
    const T &operator[](size_t index) const { return m_data[index]; }
    T &at(size_t index) { if(index>=m_size)throw out_of_range("vector::at");return m_data[index]; }
    const T &at(size_t index) const { if(index>=m_size)throw out_of_range("vector::at");return m_data[index]; }
    T *data() { return m_data; }
    const T *data() const { return m_data; }
    iterator begin() { return m_data; }
    const_iterator begin() const { return m_data; }
    const_iterator cbegin() const { return m_data; }
    iterator end() { return m_data ? m_data + m_size : m_data; }
    const_iterator end() const { return m_data ? m_data + m_size : m_data; }
    const_iterator cend() const { return m_data ? m_data + m_size : m_data; }
    size_t size() const { return m_size; }
    size_t capacity() const { return m_capacity; }
    bool empty() const { return m_size == 0; }
    T &front() { return m_data[0]; }
    const T &front() const { return m_data[0]; }
    T &back() { return m_data[m_size - 1]; }
    const T &back() const { return m_data[m_size - 1]; }

    void clear() noexcept
    {
      while (m_size)
        m_data[--m_size].~T();
    }

    void reserve(size_t capacity)
    {
      if (capacity <= m_capacity)
        return;
      T *next = allocate(capacity);
      size_t constructed = 0;
      try
      {
        for (; constructed < m_size; ++constructed)
          new (next + constructed) T(m_data[constructed]);
      }
      catch (...)
      {
        while (constructed)
          next[--constructed].~T();
        free(next);
        throw;
      }
      size_t size = m_size;
      clear();
      free(m_data);
      m_data = next;
      m_size = size;
      m_capacity = capacity;
    }

    void push_back(const T &value) { emplace_back(value); }
    void push_back(T &&value) { emplace_back(std::move(value)); }

    template<class... Args>
    T &emplace_back(Args &&...args)
    {
      if (m_size == m_capacity)
      {
        size_t capacity = m_capacity ? m_capacity * 2 : 4;
        if (capacity < m_capacity)
          throw bad_alloc();
        T *next = allocate(capacity);
        size_t constructed = 0;
        // Construct the inserted value before relocating an aliased argument.
        bool inserted = false;
        try
        {
          new (next + m_size) T(std::forward<Args>(args)...);
          inserted = true;
          for (; constructed < m_size; ++constructed)
            new (next + constructed) T(m_data[constructed]);
        }
        catch (...)
        {
          while (constructed)
            next[--constructed].~T();
          if (inserted) next[m_size].~T();
          free(next);
          throw;
        }
        size_t size = m_size;
        clear();
        free(m_data);
        m_data = next;
        m_size = size;
        m_capacity = capacity;
      }
      else
        new (m_data + m_size) T(std::forward<Args>(args)...);
      return m_data[m_size++];
    }

    void pop_back() { if (m_size) m_data[--m_size].~T(); }

    iterator erase(const_iterator first,const_iterator last)
    {
      size_t start=m_data?size_t(first-m_data):0;
      size_t count=first==last?0:size_t(last-first);
      if(!count)return m_data?m_data+start:m_data;
      for(size_t i=start;i+count<m_size;++i)m_data[i]=std::move(m_data[i+count]);
      for(size_t i=0;i<count;++i)pop_back();
      return m_data+start;
    }
    iterator erase(const_iterator position){return erase(position,position+1);}
    template<class... Args> iterator emplace(const_iterator position,Args&&... args)
    {
      size_t index=m_data?size_t(position-m_data):0;
      T value(std::forward<Args>(args)...);
      if(index==m_size){emplace_back(std::move(value));return m_data+index;}
      if(m_size==m_capacity)reserve(m_capacity?m_capacity*2:4);
      new(m_data+m_size)T(std::move(m_data[m_size-1]));++m_size;
      for(size_t i=m_size-2;i>index;--i)m_data[i]=std::move(m_data[i-1]);
      m_data[index]=std::move(value);return m_data+index;
    }
    iterator insert(const_iterator position,const T& value){return emplace(position,value);}
    iterator insert(const_iterator position,T&& value){return emplace(position,std::move(value));}
    template<class InputIterator,class=typename enable_if<!is_integral<InputIterator>::value>::type>
    iterator insert(const_iterator position,InputIterator first,InputIterator last)
    {
      size_t index=m_data?size_t(position-m_data):0;
      vector incoming(first,last);
      if(incoming.empty())return m_data?m_data+index:m_data;
      size_t count=incoming.size(),old_size=m_size;
      if(count>(size_t)-1-m_size)throw bad_alloc();
      reserve(m_size+count);
      // Construct the new tail before moving existing assignments, including
      // ranges longer than the original suffix.
      size_t constructed=0;
      try {
        for(size_t i=old_size;i<old_size+count;++i){
          if(i<index+count)new(m_data+i)T(std::move(incoming[i-index]));
          else new(m_data+i)T(std::move(m_data[i-count]));
          ++constructed;
        }
      }catch(...){while(constructed)m_data[old_size+--constructed].~T();throw;}
      m_size+=count;
      for(size_t i=old_size;i>index;--i)if(i-1+count<old_size)m_data[i-1+count]=std::move(m_data[i-1]);
      for(size_t i=0;i<count&&index+i<old_size;++i)m_data[index+i]=std::move(incoming[i]);
      return m_data+index;
    }

    void resize(size_t count)
    {
      if (count < m_size)
      {
        while (m_size > count) pop_back();
        return;
      }
      reserve(count);
      size_t old_size = m_size;
      try
      {
        while (m_size < count)
        {
          new (m_data + m_size) T();
          ++m_size;
        }
      }
      catch (...)
      {
        while (m_size > old_size) pop_back();
        throw;
      }
    }

    void resize(size_t count, const T &value)
    {
      if (count <= m_size)
      {
        while (m_size > count) pop_back();
        return;
      }
      T stable_value(value);
      reserve(count);
      size_t old_size = m_size;
      try
      {
        while (m_size < count)
        {
          new (m_data + m_size) T(stable_value);
          ++m_size;
        }
      }
      catch (...)
      {
        while (m_size > old_size) pop_back();
        throw;
      }
    }

    void assign(size_t count, const T &value)
    {
      vector replacement(count, value);
      swap(replacement);
    }

  private:
    static T *allocate(size_t count)
    {
      if (count > (size_t)-1 / sizeof(T))
        throw bad_alloc();
      T *data = (T *)malloc(count * sizeof(T));
      if (!data)
        throw bad_alloc();
      return data;
    }

    T *m_data;
    size_t m_size;
    size_t m_capacity;
  };
}

#endif
