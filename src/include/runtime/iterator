template<class C, class Traits = char_traits<C> >
class ostreambuf_iterator {
public:
  typedef C char_type;
  typedef Traits traits_type;
  typedef basic_streambuf<C,Traits> streambuf_type;
  typedef basic_ostream<C,Traits> ostream_type;
  typedef output_iterator_tag iterator_category;
  typedef void value_type;
  typedef void difference_type;
  typedef void pointer;
  typedef void reference;
  ostreambuf_iterator(streambuf_type *buffer) : m_sbuf(buffer), m_failed(buffer == 0) {}
  ostreambuf_iterator(ostream_type &stream) : m_sbuf(stream.rdbuf()), m_failed(m_sbuf == 0) {}
  ostreambuf_iterator& operator=(C c) {
    if(!m_failed && Traits::eq_int_type(m_sbuf->sputc(c),Traits::eof()))m_failed=true;
    return *this;
  }
  ostreambuf_iterator& operator*() { return *this; }
  ostreambuf_iterator& operator++() { return *this; }
  ostreambuf_iterator& operator++(int) { return *this; }
  bool failed() const { return m_failed; }
private:
  streambuf_type *m_sbuf;
  bool m_failed;
};
template<class C, class Traits = char_traits<C> >
class istreambuf_iterator {
public:
  typedef C char_type;
  typedef Traits traits_type;
  typedef typename Traits::int_type int_type;
  typedef basic_streambuf<C,Traits> streambuf_type;
  typedef basic_istream<C,Traits> istream_type;
  typedef input_iterator_tag iterator_category;
  typedef C value_type;
  typedef ptrdiff_t difference_type;
  typedef const C *pointer;
  typedef C reference;
  istreambuf_iterator() : m_sbuf(0), m_curr(Traits::eof()) {}
  istreambuf_iterator(istream_type &stream) : m_sbuf(stream.rdbuf()), m_curr(sgetc()) {}
  istreambuf_iterator(streambuf_type *buffer) : m_sbuf(buffer), m_curr(sgetc()) {}
  C operator*() const { return Traits::to_char_type(m_curr); }
  istreambuf_iterator& operator++() {
    if(m_sbuf) {
      if(Traits::eq_int_type(m_sbuf->sbumpc(),Traits::eof())) m_sbuf = 0;
      else m_curr = sgetc();
    }
    return *this;
  }
  istreambuf_iterator operator++(int) {
    istreambuf_iterator tmp = *this;
    ++*this;
    return tmp;
  }
  bool equal(const istreambuf_iterator &other) const {
    return m_sbuf == other.m_sbuf ||
           (m_sbuf == 0 && Traits::eq_int_type(other.m_curr,Traits::eof())) ||
           (other.m_sbuf == 0 && Traits::eq_int_type(m_curr,Traits::eof()));
  }
  bool operator==(const istreambuf_iterator &other) const { return equal(other); }
  bool operator!=(const istreambuf_iterator &other) const { return !equal(other); }
private:
  int_type sgetc() { return m_sbuf ? m_sbuf->sgetc() : Traits::eof(); }
  streambuf_type *m_sbuf;
  int_type m_curr;
};
}
#endif
