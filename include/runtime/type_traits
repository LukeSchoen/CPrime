#ifndef _CPC_TYPE_TRAITS
#define _CPC_TYPE_TRAITS

namespace std
{
  template<class T, T Value> struct integral_constant {
    static constexpr T value = Value;
    typedef T value_type;
    typedef integral_constant type;
  };
  typedef integral_constant<bool, true> true_type;
  typedef integral_constant<bool, false> false_type;
  template<bool Value> using bool_constant = integral_constant<bool, Value>;

  template<class T> struct is_integral { static const bool value = false; };
  template<> struct is_integral<bool> { static const bool value = true; };
  template<> struct is_integral<char> { static const bool value = true; };
  template<> struct is_integral<int> { static const bool value = true; };
  template<> struct is_integral<long> { static const bool value = true; };

  template<class T> struct is_enum { static const bool value = false; };
  template<class T, class U> struct is_same { static const bool value = false; };
  template<class T> struct is_same<T, T> { static const bool value = true; };

  template<class T> struct is_floating_point { static const bool value = false; };
  template<> struct is_floating_point<float> { static const bool value = true; };
  template<> struct is_floating_point<double> { static const bool value = true; };

  template<class T> struct is_signed { static const bool value = false; };
  typedef signed char __cpc_signed_char;
  typedef long long __cpc_signed_long_long;
  typedef long double __cpc_long_double;
  template<> struct is_signed<__cpc_signed_char> { static const bool value = true; };
  template<> struct is_signed<char> { static const bool value = char(-1) < char(0); };
  template<> struct is_signed<short> { static const bool value = true; };
  template<> struct is_signed<int> { static const bool value = true; };
  template<> struct is_signed<long> { static const bool value = true; };
  template<> struct is_signed<__cpc_signed_long_long> { static const bool value = true; };
  template<> struct is_signed<float> { static const bool value = true; };
  template<> struct is_signed<double> { static const bool value = true; };
  template<> struct is_signed<__cpc_long_double> { static const bool value = true; };
  template<class T> struct is_signed<const T> : is_signed<T> {};
  template<class T> struct is_signed<volatile T> : is_signed<T> {};
  template<class T> struct is_signed<const volatile T> : is_signed<T> {};
  typedef unsigned char __cpc_unsigned_char;
  typedef unsigned short __cpc_unsigned_short;
  typedef unsigned int __cpc_unsigned_int;
  typedef unsigned long __cpc_unsigned_long;
  typedef unsigned long long __cpc_unsigned_long_long;
  template<class T> struct is_unsigned { static const bool value = false; };
  template<> struct is_unsigned<__cpc_unsigned_char> { static const bool value = true; };
  template<> struct is_unsigned<__cpc_unsigned_short> { static const bool value = true; };
  template<> struct is_unsigned<__cpc_unsigned_int> { static const bool value = true; };
  template<> struct is_unsigned<__cpc_unsigned_long> { static const bool value = true; };
  template<> struct is_unsigned<__cpc_unsigned_long_long> { static const bool value = true; };

  template<bool B, class T, class F> struct conditional { typedef F type; };
  template<class T, class F> struct conditional<true, T, F> { typedef T type; };
  template<bool B, class T, class F> using conditional_t = typename conditional<B, T, F>::type;

  template<bool B, class T = void> struct enable_if { };
  template<class T> struct enable_if<true, T> { typedef T type; };
  template<bool B, class T = void> using enable_if_t = typename enable_if<B, T>::type;

  template<class T> struct remove_reference { typedef T type; };
  template<class T> struct remove_reference<T&> { typedef T type; };
  template<class T> struct remove_reference<T&&> { typedef T type; };

  template<class T> struct remove_const { typedef T type; };
  template<class T> struct remove_const<const T> { typedef T type; };

  template<class T> struct underlying_type { typedef int type; };
  template<class T> using underlying_type_t = typename underlying_type<T>::type;

}

#endif
