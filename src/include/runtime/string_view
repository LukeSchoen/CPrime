#ifndef _CPC_STRING_VIEW
#define _CPC_STRING_VIEW

#include <stddef.h>

namespace std
{
  template<class C>
  class basic_string_view
  {
  public:
    typedef C value_type;
    typedef size_t size_type;
    typedef const C *const_iterator;
    typedef const_iterator iterator;

    constexpr basic_string_view() noexcept : m_data(0), m_size(0) {}
    constexpr basic_string_view(const C *text, size_type count)
      : m_data(text), m_size(count) {}
    basic_string_view(const C *text) : m_data(text), m_size(0)
    {
      if (text)
        m_size = length(text);
    }

    constexpr const_iterator begin() const noexcept { return m_data; }
    constexpr const_iterator end() const noexcept { return m_data + m_size; }
    constexpr const_iterator cbegin() const noexcept { return begin(); }
    constexpr const_iterator cend() const noexcept { return end(); }
    constexpr const C *data() const noexcept { return m_data; }
    constexpr size_type size() const noexcept { return m_size; }
    constexpr size_type length() const noexcept { return m_size; }
    constexpr bool empty() const noexcept { return m_size == 0; }
    constexpr const C &operator[](size_type index) const { return m_data[index]; }
    constexpr const C &front() const { return m_data[0]; }
    constexpr const C &back() const { return m_data[m_size - 1]; }
    static constexpr size_type npos = (size_type)-1;

    constexpr int compare(basic_string_view other) const
    {
      size_type count = m_size < other.m_size ? m_size : other.m_size;
      for (size_type i = 0; i < count; ++i)
        if (m_data[i] != other.m_data[i])
          return m_data[i] < other.m_data[i] ? -1 : 1;
      if (m_size == other.m_size) return 0;
      return m_size < other.m_size ? -1 : 1;
    }
    constexpr int compare(const C *text) const
    {
      return compare(basic_string_view(text));
    }
    constexpr int compare(const C *text, size_type count) const
    {
      return compare(basic_string_view(text, count));
    }
    constexpr int compare(size_type position, size_type count,
                          basic_string_view other) const
    {
      return substr(position, count).compare(other);
    }
    constexpr int compare(size_type position, size_type count,
                          const C *text) const
    {
      return substr(position, count).compare(basic_string_view(text));
    }
    constexpr int compare(size_type position, size_type count,
                          const C *text, size_type text_count) const
    {
      return substr(position, count).compare(basic_string_view(text, text_count));
    }

    constexpr size_type find(basic_string_view needle, size_type position = 0) const
    {
      if (needle.m_size == 0)
        return position <= m_size ? position : npos;
      for (size_type i = position; i + needle.m_size <= m_size; ++i)
      {
        size_type j = 0;
        while (j < needle.m_size && m_data[i + j] == needle.m_data[j]) ++j;
        if (j == needle.m_size) return i;
      }
      return npos;
    }
    constexpr size_type find(C character, size_type position = 0) const
    {
      for (size_type i = position; i < m_size; ++i)
        if (m_data[i] == character) return i;
      return npos;
    }
    constexpr size_type find(const C *text, size_type position, size_type count) const
    {
      return find(basic_string_view(text, count), position);
    }
    constexpr size_type find(const C *text, size_type position = 0) const
    {
      return find(basic_string_view(text), position);
    }

    constexpr size_type rfind(basic_string_view needle, size_type position = npos) const
    {
      if (needle.m_size == 0)
        return position < m_size ? position : m_size;
      if (needle.m_size > m_size) return npos;
      size_type last = m_size - needle.m_size;
      size_type start = position < last ? position : last;
      for (size_type i = start; ; --i)
      {
        size_type j = 0;
        while (j < needle.m_size && m_data[i + j] == needle.m_data[j]) ++j;
        if (j == needle.m_size) return i;
        if (i == 0) break;
      }
      return npos;
    }
    constexpr size_type rfind(C character, size_type position = npos) const
    {
      if (m_size == 0) return npos;
      size_type start = position < m_size ? position : m_size - 1;
      for (size_type i = start; ; --i)
      {
        if (m_data[i] == character) return i;
        if (i == 0) break;
      }
      return npos;
    }
    constexpr size_type rfind(const C *text, size_type position, size_type count) const
    {
      return rfind(basic_string_view(text, count), position);
    }
    constexpr size_type rfind(const C *text, size_type position = npos) const
    {
      return rfind(basic_string_view(text), position);
    }

    constexpr size_type find_first_of(basic_string_view characters,
                                      size_type position = 0) const
    {
      for (size_type i = position; i < m_size; ++i)
        for (size_type j = 0; j < characters.m_size; ++j)
          if (m_data[i] == characters.m_data[j]) return i;
      return npos;
    }
    constexpr size_type find_first_of(C character, size_type position = 0) const
    {
      return find(character, position);
    }
    constexpr size_type find_last_of(basic_string_view characters,
                                     size_type position = npos) const
    {
      if (m_size == 0) return npos;
      size_type start = position < m_size ? position : m_size - 1;
      for (size_type i = start; ; --i)
      {
        for (size_type j = 0; j < characters.m_size; ++j)
          if (m_data[i] == characters.m_data[j]) return i;
        if (i == 0) break;
      }
      return npos;
    }
    constexpr size_type find_last_of(C character, size_type position = npos) const
    {
      return rfind(character, position);
    }
    constexpr size_type find_first_not_of(basic_string_view characters,
                                          size_type position = 0) const
    {
      for (size_type i = position; i < m_size; ++i)
      {
        size_type j = 0;
        while (j < characters.m_size && m_data[i] != characters.m_data[j]) ++j;
        if (j == characters.m_size) return i;
      }
      return npos;
    }
    constexpr size_type find_first_not_of(C character, size_type position = 0) const
    {
      for (size_type i = position; i < m_size; ++i)
        if (m_data[i] != character) return i;
      return npos;
    }
    constexpr size_type find_last_not_of(basic_string_view characters,
                                         size_type position = npos) const
    {
      if (m_size == 0) return npos;
      size_type start = position < m_size ? position : m_size - 1;
      for (size_type i = start; ; --i)
      {
        size_type j = 0;
        while (j < characters.m_size && m_data[i] != characters.m_data[j]) ++j;
        if (j == characters.m_size) return i;
        if (i == 0) break;
      }
      return npos;
    }
    constexpr size_type find_last_not_of(C character, size_type position = npos) const
    {
      if (m_size == 0) return npos;
      size_type start = position < m_size ? position : m_size - 1;
      for (size_type i = start; ; --i)
      {
        if (m_data[i] != character) return i;
        if (i == 0) break;
      }
      return npos;
    }

    constexpr basic_string_view substr(size_type position = 0,
                                       size_type count = (size_type)-1) const
    {
      return position > m_size ? basic_string_view()
        : basic_string_view(m_data + position,
                            count > m_size - position ? m_size - position
                                                      : count);
    }

    void remove_prefix(size_type count)
    {
      if (count > m_size) count = m_size;
      m_data += count;
      m_size -= count;
    }
    void remove_suffix(size_type count)
    {
      if (count > m_size) count = m_size;
      m_size -= count;
    }

  private:
    static size_type length(const C *text)
    {
      size_type result = 0;
      while (text[result]) ++result;
      return result;
    }

    const C *m_data;
    size_type m_size;
  };

  typedef basic_string_view<char> string_view;
  typedef basic_string_view<wchar_t> wstring_view;

  template<class C>
  bool operator==(basic_string_view<C> left, basic_string_view<C> right)
  {
    if (left.size() != right.size()) return false;
    for (size_t i = 0; i < left.size(); ++i)
      if (left[i] != right[i]) return false;
    return true;
  }
  template<class C>
  bool operator!=(basic_string_view<C> left, basic_string_view<C> right)
  {
    return !(left == right);
  }
  template<class C>
  bool operator<(basic_string_view<C> left, basic_string_view<C> right)
  {
    size_t count = left.size() < right.size() ? left.size() : right.size();
    for (size_t i = 0; i < count; ++i)
      if (left[i] < right[i]) return true;
      else if (right[i] < left[i]) return false;
    return left.size() < right.size();
  }
  template<class C>
  bool operator>(basic_string_view<C> left, basic_string_view<C> right)
  {
    return right < left;
  }
  template<class C>
  bool operator<=(basic_string_view<C> left, basic_string_view<C> right)
  {
    return !(right < left);
  }
  template<class C>
  bool operator>=(basic_string_view<C> left, basic_string_view<C> right)
  {
    return !(left < right);
  }
}

#endif
