#ifndef _CPC_MEMORY
#define _CPC_MEMORY

#include <stddef.h>
#include <utility>
#include <new>
#include <atomic>
#include <stdlib.h>

namespace std
{
  template<class T> class allocator {
  public:
    typedef T value_type;
    typedef T *pointer;
    typedef const T *const_pointer;
    typedef T &reference;
    typedef const T &const_reference;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    template<class U> struct rebind { typedef allocator<U> other; };

    allocator() noexcept {}
    template<class U> allocator(const allocator<U>&) noexcept {}
    pointer address(reference value) const noexcept { return &value; }
    const_pointer address(const_reference value) const noexcept { return &value; }
    pointer allocate(size_type n, const void * = 0) {
      if (n > (size_t)-1 / sizeof(T)) throw bad_alloc();
      void* p = malloc(n * sizeof(T));
      if (!p && n) throw bad_alloc();
      return static_cast<T*>(p);
    }
    void deallocate(pointer p, size_type) { free(p); }
    size_type max_size() const noexcept { return (size_type)-1 / sizeof(T); }
    template<class U, class... Args>
    void construct(U *p, Args &&...args)
    {
      ::new (static_cast<void *>(p)) U(static_cast<Args &&>(args)...);
    }
    template<class U>
    void destroy(U *p)
    {
      p->~U();
    }
  };
  template<class T, class U>
  bool operator==(const allocator<T> &, const allocator<U> &) noexcept
  {
    return true;
  }
  template<class T, class U>
  bool operator!=(const allocator<T> &, const allocator<U> &) noexcept
  {
    return false;
  }
  /* C++98's auto_ptr, kept for the pre-C++17 libraries that still select it:
     Boost's smart_ptr/scoped_ptr.hpp guards its auto_ptr constructor with
     BOOST_NO_AUTO_PTR, and Boost.Config only defines that macro from a
     standard-library identity this runtime does not advertise.  Copying an
     auto_ptr transfers ownership, and the auto_ptr_ref proxy is what lets a
     by-value parameter or a temporary take ownership even though the copy
     constructor takes a non-const reference. */
  template<class T>
  struct auto_ptr_ref
  {
    explicit auto_ptr_ref(T *p) noexcept : m_ptr(p) {}
    T *m_ptr;
  };

  template<class T>
  class auto_ptr
  {
  public:
    typedef T element_type;

    explicit auto_ptr(T *p = 0) noexcept : m_ptr(p) {}
    auto_ptr(auto_ptr<T> &other) noexcept : m_ptr(other.release()) {}
    auto_ptr(auto_ptr_ref<T> other) noexcept : m_ptr(other.m_ptr)
    {
      other.m_ptr = 0;
    }

    template<class U>
    auto_ptr(auto_ptr<U> &other) noexcept : m_ptr(other.release()) {}

    template<class U>
    operator auto_ptr_ref<U>() noexcept
    {
      U *converted = m_ptr;
      auto_ptr_ref<U> result(converted);
      m_ptr = 0;
      return result;
    }

    template<class U>
    operator auto_ptr<U>() noexcept
    {
      return auto_ptr<U>(*this);
    }

    auto_ptr &operator=(auto_ptr<T> &other) noexcept
    {
      reset(other.release());
      return *this;
    }

    template<class U>
    auto_ptr &operator=(auto_ptr<U> &other) noexcept
    {
      reset(other.release());
      return *this;
    }

    auto_ptr &operator=(auto_ptr_ref<T> other) noexcept
    {
      if (other.m_ptr != m_ptr)
      {
        delete m_ptr;
        m_ptr = other.m_ptr;
      }
      other.m_ptr = 0;
      return *this;
    }

    ~auto_ptr() { delete m_ptr; }

    T &operator*() const { return *m_ptr; }
    T *operator->() const { return m_ptr; }
    T *get() const noexcept { return m_ptr; }

    T *release() noexcept
    {
      T *p = m_ptr;
      m_ptr = 0;
      return p;
    }

    void reset(T *p = 0)
    {
      if (p != m_ptr)
      {
        delete m_ptr;
        m_ptr = p;
      }
    }

  private:
    T *m_ptr;
  };

  template<class T>
  class unique_ptr
  {
  public:
    unique_ptr() : m_ptr(0) {}
    explicit unique_ptr(T *p) : m_ptr(p) {}
    unique_ptr(unique_ptr &&o) : m_ptr(o.m_ptr) { o.m_ptr = 0; }
    ~unique_ptr() { delete m_ptr; }

    unique_ptr &operator=(unique_ptr &&o)
    {
      if (this != &o)
      {
        delete m_ptr;
        m_ptr = o.m_ptr;
        o.m_ptr = 0;
      }
      return *this;
    }
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;

    T *operator->() const { return m_ptr; }
    T &operator*() const { return *m_ptr; }
    T *get() const { return m_ptr; }
    void reset(T *p = 0) { delete m_ptr; m_ptr = p; }
    explicit operator bool() const { return m_ptr != 0; }

  private:
    T *m_ptr;
  };

  template<class T>
  class unique_ptr<T[]>
  {
  public:
    unique_ptr() : m_ptr(0) {}
    explicit unique_ptr(T *pointer) : m_ptr(pointer) {}
    unique_ptr(unique_ptr &&other) : m_ptr(other.m_ptr) { other.m_ptr = 0; }
    ~unique_ptr() { delete[] m_ptr; }
    unique_ptr &operator=(unique_ptr &&other)
    {
      if (this != &other)
      {
        delete[] m_ptr;
        m_ptr = other.m_ptr;
        other.m_ptr = 0;
      }
      return *this;
    }
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    T &operator[](size_t index) const { return m_ptr[index]; }
    T *get() const { return m_ptr; }
    void reset(T *pointer = 0) { delete[] m_ptr; m_ptr = pointer; }
    explicit operator bool() const { return m_ptr != 0; }
  private:
    T *m_ptr;
  };

  template<class T, class... Args>
  typename enable_if<!std::is_array<T>::value, unique_ptr<T> >::type
  make_unique(Args &&...args)
  {
    return unique_ptr<T>(new T(std::forward<Args>(args)...));
  }

  template<class T>
  typename enable_if<std::is_array<T>::value, unique_ptr<T> >::type
  make_unique(size_t count)
  {
    typedef typename remove_extent<T>::type element_type;
    return unique_ptr<T>(new element_type[count]);
  }
}


namespace std {
class __cpc_shared_control {
public:
  atomic<long> strong;
  atomic<long> weak;
  __cpc_shared_control() : strong(1), weak(1) {}
  virtual ~__cpc_shared_control() {}
  virtual void dispose() = 0;
  void release_weak() { if (weak.fetch_sub(1) == 1) delete this; }
  void release() { if (strong.fetch_sub(1) == 1) { dispose(); release_weak(); } }
};
template<class T> class __cpc_shared_pointer_control : public __cpc_shared_control {
  T* pointer;
public:
  __cpc_shared_pointer_control(T* p) : pointer(p) {}
  void dispose() override { delete pointer; }
};
/* An array shared pointer owns what `new[]` allocated, so disposal must
   match the allocation form. */
template<class T> class __cpc_shared_array_control : public __cpc_shared_control {
  T* pointer;
public:
  __cpc_shared_array_control(T* p) : pointer(p) {}
  void dispose() override { delete[] pointer; }
};
template<class T> class weak_ptr;
template<class T> class shared_ptr {
  template<class U> friend class shared_ptr;
  template<class U> friend class weak_ptr;
  T* pointer;
  __cpc_shared_control* control;
  shared_ptr(T* p, __cpc_shared_control* c) : pointer(p), control(c) {}
public:
  shared_ptr() noexcept : pointer(0), control(0) {}
  shared_ptr(decltype(nullptr)) noexcept : pointer(0), control(0) {}
  template<class U> explicit shared_ptr(U* p) : pointer(p), control(new __cpc_shared_pointer_control<U>(p)) {}
  shared_ptr(const shared_ptr& s) noexcept : pointer(s.pointer), control(s.control) { if(control) control->strong.fetch_add(1); }
  template<class U> shared_ptr(const shared_ptr<U>& s) noexcept : pointer(s.pointer), control(s.control) { if(control) control->strong.fetch_add(1); }
  shared_ptr(shared_ptr&& s) noexcept : pointer(s.pointer), control(s.control) { s.pointer=0; s.control=0; }
  ~shared_ptr() { if(control) control->release(); }
  shared_ptr& operator=(shared_ptr s) noexcept { swap(s); return *this; }
  void swap(shared_ptr& s) noexcept { T* p=pointer; pointer=s.pointer; s.pointer=p; __cpc_shared_control* c=control; control=s.control; s.control=c; }
  void reset() noexcept { shared_ptr().swap(*this); }
  template<class U> void reset(U* p) { shared_ptr(p).swap(*this); }
  T* get() const noexcept { return pointer; }
  T* operator->() const noexcept { return pointer; }
  T& operator*() const noexcept { return *pointer; }
  explicit operator bool() const noexcept { return pointer!=0; }
  long use_count() const noexcept { return control?control->strong.load():0; }
};
/* The C++17 array form: the pointer names an array, so indexing replaces the
   dereference operators and disposal uses delete[]. */
template<class T> class shared_ptr<T[]> {
  template<class U> friend class shared_ptr;
  T* pointer;
  __cpc_shared_control* control;
  shared_ptr(T* p, __cpc_shared_control* c) : pointer(p), control(c) {}
public:
  typedef T element_type;

  shared_ptr() noexcept : pointer(0), control(0) {}
  shared_ptr(decltype(nullptr)) noexcept : pointer(0), control(0) {}
  template<class U> explicit shared_ptr(U* p) : pointer(p), control(new __cpc_shared_array_control<U>(p)) {}
  shared_ptr(const shared_ptr& s) noexcept : pointer(s.pointer), control(s.control) { if(control) control->strong.fetch_add(1); }
  template<class U> shared_ptr(const shared_ptr<U>& s) noexcept : pointer(s.pointer), control(s.control) { if(control) control->strong.fetch_add(1); }
  shared_ptr(shared_ptr&& s) noexcept : pointer(s.pointer), control(s.control) { s.pointer=0; s.control=0; }
  ~shared_ptr() { if(control) control->release(); }
  shared_ptr& operator=(shared_ptr s) noexcept { swap(s); return *this; }
  void swap(shared_ptr& s) noexcept { T* p=pointer; pointer=s.pointer; s.pointer=p; __cpc_shared_control* c=control; control=s.control; s.control=c; }
  void reset() noexcept { shared_ptr().swap(*this); }
  template<class U> void reset(U* p) { shared_ptr(p).swap(*this); }
  T* get() const noexcept { return pointer; }
  T& operator[](size_t index) const { return pointer[index]; }
  explicit operator bool() const noexcept { return pointer!=0; }
  long use_count() const noexcept { return control?control->strong.load():0; }
};
template<class T> class weak_ptr {
  T* pointer;
  __cpc_shared_control* control;
public:
  weak_ptr() noexcept : pointer(0), control(0) {}
  weak_ptr(const shared_ptr<T>& s) noexcept : pointer(s.pointer), control(s.control) { if(control) control->weak.fetch_add(1); }
  weak_ptr(const weak_ptr& s) noexcept : pointer(s.pointer), control(s.control) { if(control) control->weak.fetch_add(1); }
  weak_ptr(weak_ptr&& s) noexcept : pointer(s.pointer), control(s.control) { s.pointer=0; s.control=0; }
  ~weak_ptr() { if(control) control->release_weak(); }
  weak_ptr& operator=(weak_ptr s) noexcept { swap(s); return *this; }
  void swap(weak_ptr& s) noexcept { T* p=pointer; pointer=s.pointer; s.pointer=p; __cpc_shared_control* c=control; control=s.control; s.control=c; }
  void reset() noexcept { weak_ptr().swap(*this); }
  long use_count() const noexcept { return control?control->strong.load():0; }
  bool expired() const noexcept { return use_count()==0; }
  shared_ptr<T> lock() const noexcept {
    if(control) {
      long n=control->strong.load();
      while(n!=0) { if(control->strong.compare_exchange_weak(n,n+1)) return shared_ptr<T>(pointer,control); }
    }
    return shared_ptr<T>();
  }
};
template<class T,class... Args> shared_ptr<T> make_shared(Args&&... args) { return shared_ptr<T>(new T(std::forward<Args>(args)...)); }
}
#endif
