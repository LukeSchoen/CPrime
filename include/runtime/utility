#ifndef _UTILITY
#define _UTILITY

namespace std
{
  template<class T>
  struct is_trivially_copyable
  {
    static const bool value = false;
  };

  template<class T>
  T&& declval();

  template<class T>
  T&& forward(T &value)
  {
    return (T&&)value;
  }

  template<class T>
  T&& move(T &value)
  {
    return (T&&)value;
  }
}

#endif
