# Generated build and profiling output
# Every area owns a build/ directory: src/build for the toolchain, one per
# worker area for its measurements and test evidence.
build/
/cpc-*.exe
/cpc.exe.bak
/src/scripts/*.new.exe
# Retained workflow executables
!/src/scripts/build.exe
!/src/scripts/build-clang.exe
!/src/scripts/build-clang-minimal.exe
!/src/scripts/benchmark-clang.exe
!/src/scripts/seed-tcc.exe
!/src/scripts/deploy.exe
!/src/scripts/maintenance.exe
!/src/scripts/performance.exe
!/src/scripts/performance-tcc.exe
!/src/scripts/profile.exe
!/src/scripts/project.exe
!/src/scripts/project-clang.exe
!/src/scripts/check_project_build.exe
!/src/scripts/tool-build.exe
# Test case artefacts
/Compatibility/tests/**/.tmp*/
/Compatibility/tests/**/*.exe
!/Compatibility/tests/test.exe
/Compatibility/tests/**/*.obj
/Compatibility/tests/**/*.o
/Compatibility/tests/**/*.s
/Compatibility/tests/**/*.err
/Cost/tests/**/*.exe
!/Cost/tests/test.exe
/Cost/tests/**/*.obj
/Cost/tests/**/*.o
/Cost/tests/**/*.err
/Capability/tests/**/*.exe
!/Capability/tests/test.exe
/Capability/tests/**/*.obj
/Capability/tests/**/*.o
/Capability/tests/**/*.err
/*.o
/*.obj
/*.pdb
/*.bak
/tmp_*

# Local diagnostics
*.log
*.err
*.out

# Worker stop markers: created by hand to stop a worker, never committed
/Cost/done.x
/Compatibility/done.x
/Capability/done.x

# Vendored TCC build output
/src/third-party/tcc/config.h
/src/third-party/tcc/config.texi
/src/third-party/tcc/win32/*.exe
/src/third-party/tcc/win32/*.dll
/src/third-party/tcc/win32/*.o
/src/third-party/tcc/win32/*.obj
/src/third-party/tcc/win32/*.def
/src/third-party/tcc/win32/*.pdb
/src/third-party/tcc/win32/*.lib
/src/third-party/tcc/win32/*.exp
/src/third-party/tcc/win32/*.ilk
/src/third-party/tcc/win32/doc/
/src/third-party/tcc/win32/lib/*.a
/src/third-party/tcc/win32/lib/*.o
/src/third-party/tcc/win32/libtcc/
**/__pycache__/

# Optional local Clang host compiler
/src/third-party/clang/bin/clang.exe
