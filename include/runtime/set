#ifndef _CPC_SET
#define _CPC_SET

#include <vector>
#include <memory>
#include <initializer_list>
#include <algorithm>

namespace std
{
  template<class Key, class Compare = void,
           class Allocator = allocator<Key> >
  class set
  {
  public:
    typedef Key key_type;
    typedef Key value_type;
    typedef size_t size_type;
    typedef typename vector<Key>::iterator iterator;
    typedef typename vector<Key>::const_iterator const_iterator;

    set() : m_values() {}
    set(initializer_list<Key> values) : m_values()
    {
      for (const Key *value = values.begin(); value != values.end(); ++value)
        insert(*value);
    }

    iterator begin() { return m_values.begin(); }
    iterator end() { return m_values.end(); }
    const_iterator begin() const { return m_values.begin(); }
    const_iterator end() const { return m_values.end(); }
    bool empty() const { return m_values.empty(); }
    size_type size() const { return m_values.size(); }

    void insert(const Key &value)
    {
      for (size_t i = 0; i < m_values.size(); ++i)
        if (!(m_values[i] < value) && !(value < m_values[i]))
          return;
      m_values.push_back(value);
      sort(m_values.begin(), m_values.end());
    }

  private:
    vector<Key> m_values;
  };
}

#endif
