#ifndef _CPC_DEQUE
#define _CPC_DEQUE
#include <memory>
#include <iterator>
#include <utility>
#include <stdlib.h>
namespace std {
/* A circular index of individually allocated elements keeps references
   stable when either end grows. Resizing moves only the index pointers. */
template<class T,class Alloc=allocator<T>> class deque {
  T** m_slots;
  size_t m_size,m_capacity;
  ptrdiff_t m_first;
  Alloc m_allocator;
  size_t slot(ptrdiff_t pos)const{return (size_t)pos&(m_capacity-1);}
  T& at_position(ptrdiff_t pos)const{return *m_slots[slot(pos)];}
  void grow(){
    if(m_size<m_capacity)return;
    size_t capacity=m_capacity?m_capacity*2:8;
    T** slots=(T**)calloc(capacity,sizeof(T*));if(!slots)throw bad_alloc();
    for(size_t i=0;i<m_size;++i){ptrdiff_t pos=m_first+(ptrdiff_t)i;slots[(size_t)pos&(capacity-1)]=m_slots[slot(pos)];}
    free(m_slots);m_slots=slots;m_capacity=capacity;
  }
public:
  typedef T value_type;
  typedef Alloc allocator_type;
  typedef size_t size_type;
  typedef ptrdiff_t difference_type;
  typedef T& reference;
  typedef const T& const_reference;
  template<bool Constant> class cursor {
    friend class deque;
    const deque* m_owner;ptrdiff_t m_position;
  public:
    typedef random_access_iterator_tag iterator_category;
    typedef T value_type;
    typedef ptrdiff_t difference_type;
    typedef typename conditional<Constant,const T*,T*>::type pointer;
    typedef typename conditional<Constant,const T&,T&>::type reference;
    cursor():m_owner(0),m_position(0){}
    cursor(const deque* owner,ptrdiff_t position):m_owner(owner),m_position(position){}
    reference operator*()const{return m_owner->at_position(m_position);}
    pointer operator->()const{return &m_owner->at_position(m_position);}
    cursor& operator++(){++m_position;return *this;}
    cursor operator++(int){cursor old=*this;++*this;return old;}
    cursor& operator--(){--m_position;return *this;}
    cursor operator--(int){cursor old=*this;--*this;return old;}
    cursor& operator+=(difference_type n){m_position+=n;return *this;}
    cursor& operator-=(difference_type n){m_position-=n;return *this;}
    cursor operator+(difference_type n)const{cursor result=*this;return result+=n;}
    cursor operator-(difference_type n)const{cursor result=*this;return result-=n;}
    difference_type operator-(const cursor& other)const{return m_position-other.m_position;}
    reference operator[](difference_type n)const{return m_owner->at_position(m_position+n);}
    bool operator==(const cursor& other)const{return m_owner==other.m_owner&&m_position==other.m_position;}
    bool operator!=(const cursor& other)const{return !(*this==other);}
    bool operator<(const cursor& other)const{return m_position<other.m_position;}
    bool operator>(const cursor& other)const{return other<*this;}
    bool operator<=(const cursor& other)const{return !(other<*this);}
    bool operator>=(const cursor& other)const{return !(*this<other);}
  };
  typedef cursor<false> iterator;
  typedef cursor<true> const_iterator;
  deque():m_slots(0),m_size(0),m_capacity(0),m_first(0),m_allocator(){}
  explicit deque(size_t count):deque(){while(count--)emplace_back();}
  deque(size_t count,const T& value):deque(){while(count--)push_back(value);}
  deque(const deque& other):deque(){for(const_iterator i=other.begin();i!=other.end();++i)push_back(*i);}
  deque(deque&& other)noexcept:deque(){swap(other);}
  ~deque(){clear();free(m_slots);}
  deque& operator=(const deque& other){if(this!=&other){deque copy(other);swap(copy);}return *this;}
  deque& operator=(deque&& other)noexcept{if(this!=&other){clear();swap(other);}return *this;}
  void swap(deque& other){std::swap(m_slots,other.m_slots);std::swap(m_size,other.m_size);std::swap(m_capacity,other.m_capacity);std::swap(m_first,other.m_first);std::swap(m_allocator,other.m_allocator);}
  bool empty()const{return !m_size;}
  size_t size()const{return m_size;}
  iterator begin(){return iterator(this,m_first);}
  iterator end(){return iterator(this,m_first+(ptrdiff_t)m_size);}
  const_iterator begin()const{return const_iterator(this,m_first);}
  const_iterator end()const{return const_iterator(this,m_first+(ptrdiff_t)m_size);}
  T& operator[](size_t n){return at_position(m_first+(ptrdiff_t)n);}
  const T& operator[](size_t n)const{return at_position(m_first+(ptrdiff_t)n);}
  T& front(){return (*this)[0];}const T& front()const{return (*this)[0];}
  T& back(){return (*this)[m_size-1];}const T& back()const{return (*this)[m_size-1];}
  template<class... Args> T& emplace_back(Args&&... args){grow();T* value=m_allocator.allocate(1);new(value)T(std::forward<Args>(args)...);m_slots[slot(m_first+(ptrdiff_t)m_size)]=value;++m_size;return *value;}
  template<class... Args> T& emplace_front(Args&&... args){grow();T* value=m_allocator.allocate(1);new(value)T(std::forward<Args>(args)...);--m_first;m_slots[slot(m_first)]=value;++m_size;return *value;}
  void push_back(const T& value){emplace_back(value);}void push_back(T&& value){emplace_back(std::move(value));}
  void push_front(const T& value){emplace_front(value);}void push_front(T&& value){emplace_front(std::move(value));}
  void pop_front(){T* value=m_slots[slot(m_first)];value->~T();m_allocator.deallocate(value,1);++m_first;--m_size;}
  void pop_back(){--m_size;T* value=m_slots[slot(m_first+(ptrdiff_t)m_size)];value->~T();m_allocator.deallocate(value,1);}
  void clear(){while(m_size)pop_back();}
};
}
#endif
