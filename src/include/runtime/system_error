#ifndef _CPC_SYSTEM_ERROR
#define _CPC_SYSTEM_ERROR

#include <stdexcept>
#include <string>
#include <type_traits>

namespace std
{
  /* [syserr.errcode] uses the implementation errno values.  The runtime is
     built for the portable Windows target, but the callers and the existing
     character-conversion cases use the POSIX numbering that the compiler has
     always exposed. */
  enum class errc
  {
    success = 0,
    address_family_not_supported = 97,
    address_in_use = 98,
    address_not_available = 99,
    already_connected = 106,
    argument_list_too_long = 7,
    argument_out_of_domain = 33,
    bad_address = 14,
    bad_file_descriptor = 9,
    bad_message = 74,
    broken_pipe = 32,
    connection_aborted = 103,
    connection_already_in_progress = 114,
    connection_refused = 111,
    connection_reset = 104,
    cross_device_link = 18,
    destination_address_required = 89,
    device_or_resource_busy = 16,
    directory_not_empty = 39,
    executable_format_error = 8,
    file_exists = 17,
    file_too_large = 27,
    filename_too_long = 36,
    function_not_supported = 38,
    host_unreachable = 113,
    identifier_removed = 43,
    illegal_byte_sequence = 84,
    inappropriate_io_control_operation = 25,
    interrupted = 4,
    invalid_argument = 22,
    invalid_seek = 29,
    io_error = 5,
    is_a_directory = 21,
    message_size = 90,
    network_down = 100,
    network_reset = 102,
    network_unreachable = 101,
    no_buffer_space = 105,
    no_child_process = 10,
    no_link = 67,
    no_lock_available = 37,
    no_message_available = 61,
    no_message = 42,
    no_protocol_option = 92,
    no_space_on_device = 28,
    no_stream_resources = 63,
    no_such_device_or_address = 6,
    no_such_device = 19,
    no_such_file_or_directory = 2,
    no_such_process = 3,
    not_a_directory = 20,
    not_a_socket = 88,
    not_a_stream = 60,
    not_connected = 107,
    not_enough_memory = 12,
    not_supported = 95,
    operation_canceled = 125,
    operation_in_progress = 115,
    operation_not_permitted = 1,
    operation_not_supported = 95,
    operation_would_block = 11,
    owner_dead = 130,
    permission_denied = 13,
    protocol_error = 71,
    protocol_not_supported = 93,
    read_only_file_system = 30,
    resource_deadlock_would_occur = 35,
    resource_unavailable_try_again = 11,
    result_out_of_range = 34,
    state_not_recoverable = 131,
    stream_timeout = 62,
    text_file_busy = 26,
    timed_out = 110,
    too_many_files_open_in_system = 23,
    too_many_files_open = 24,
    too_many_links = 31,
    too_many_symbolic_link_levels = 40,
    value_too_large = 75,
    wrong_protocol_type = 91
  };

  template<class T> struct is_error_code_enum : false_type {};
  template<> struct is_error_code_enum<errc> : true_type {};
  template<class T> struct is_error_condition_enum : false_type {};
  template<> struct is_error_condition_enum<errc> : true_type {};

  class error_category;
  class error_code;
  class error_condition;
  class system_error;

  error_code make_error_code(errc value) noexcept;
  error_condition make_error_condition(errc value) noexcept;
  const error_category &generic_category() noexcept;
  const error_category &system_category() noexcept;

  class error_category
  {
  public:
    error_category() noexcept {}
    virtual ~error_category() noexcept {}
    error_category(const error_category &) = delete;
    error_category &operator=(const error_category &) = delete;

    virtual const char *name() const noexcept = 0;
    virtual string message(int value) const = 0;
    virtual error_condition default_error_condition(int value) const noexcept;
    virtual bool equivalent(int value, const error_condition &condition) const noexcept;
    virtual bool equivalent(const error_code &code, int value) const noexcept;
  };

  class error_code
  {
  public:
    error_code() noexcept : m_value(0), m_category(&system_category()) {}
    error_code(int value, const error_category &category) noexcept
      : m_value(value), m_category(&category) {}

    template<class ErrorCodeEnum,
             typename enable_if<is_error_code_enum<ErrorCodeEnum>::value, int>::type = 0>
    error_code(ErrorCodeEnum value) noexcept : m_value(0), m_category(0)
    {
      *this = make_error_code(value);
    }

    void assign(int value, const error_category &category) noexcept
    {
      m_value = value;
      m_category = &category;
    }

    template<class ErrorCodeEnum,
             typename enable_if<is_error_code_enum<ErrorCodeEnum>::value, int>::type = 0>
    error_code &operator=(ErrorCodeEnum value) noexcept
    {
      *this = make_error_code(value);
      return *this;
    }

    void clear() noexcept
    {
      m_value = 0;
      m_category = &system_category();
    }

    int value() const noexcept { return m_value; }
    const error_category &category() const noexcept { return *m_category; }
    error_condition default_error_condition() const noexcept;
    string message() const;
    explicit operator bool() const noexcept { return m_value != 0; }

  private:
    int m_value;
    const error_category *m_category;
  };

  class error_condition
  {
  public:
    error_condition() noexcept : m_value(0), m_category(&generic_category()) {}
    error_condition(int value, const error_category &category) noexcept
      : m_value(value), m_category(&category) {}

    template<class ErrorConditionEnum,
             typename enable_if<is_error_condition_enum<ErrorConditionEnum>::value, int>::type = 0>
    error_condition(ErrorConditionEnum value) noexcept : m_value(0), m_category(0)
    {
      *this = make_error_condition(value);
    }

    void assign(int value, const error_category &category) noexcept
    {
      m_value = value;
      m_category = &category;
    }

    template<class ErrorConditionEnum,
             typename enable_if<is_error_condition_enum<ErrorConditionEnum>::value, int>::type = 0>
    error_condition &operator=(ErrorConditionEnum value) noexcept
    {
      *this = make_error_condition(value);
      return *this;
    }

    void clear() noexcept
    {
      m_value = 0;
      m_category = &generic_category();
    }

    int value() const noexcept { return m_value; }
    const error_category &category() const noexcept { return *m_category; }
    string message() const;
    explicit operator bool() const noexcept { return m_value != 0; }

  private:
    int m_value;
    const error_category *m_category;
  };

  inline error_code make_error_code(errc value) noexcept
  {
    return error_code(static_cast<int>(value), generic_category());
  }

  inline error_condition make_error_condition(errc value) noexcept
  {
    return error_condition(static_cast<int>(value), generic_category());
  }

  inline bool operator==(const error_category &left, const error_category &right) noexcept
  {
    return &left == &right;
  }
  inline bool operator!=(const error_category &left, const error_category &right) noexcept
  {
    return !(left == right);
  }

  inline bool operator==(const error_code &left, const error_code &right) noexcept
  {
    return left.category() == right.category() && left.value() == right.value();
  }
  inline bool operator==(const error_condition &left, const error_condition &right) noexcept
  {
    return left.category() == right.category() && left.value() == right.value();
  }
  inline bool operator==(const error_code &left, const error_condition &right) noexcept
  {
    return left.category().equivalent(left.value(), right)
        || right.category().equivalent(left, right.value());
  }
  inline bool operator==(const error_condition &left, const error_code &right) noexcept
  {
    return right == left;
  }
  inline bool operator!=(const error_code &left, const error_code &right) noexcept
  {
    return !(left == right);
  }
  inline bool operator!=(const error_condition &left, const error_condition &right) noexcept
  {
    return !(left == right);
  }
  inline bool operator!=(const error_code &left, const error_condition &right) noexcept
  {
    return !(left == right);
  }
  inline bool operator!=(const error_condition &left, const error_code &right) noexcept
  {
    return !(left == right);
  }

  inline bool operator==(const error_code &left, errc right) noexcept
  {
    return left == make_error_code(right);
  }
  inline bool operator==(errc left, const error_code &right) noexcept
  {
    return make_error_code(left) == right;
  }
  inline bool operator!=(const error_code &left, errc right) noexcept
  {
    return !(left == right);
  }
  inline bool operator!=(errc left, const error_code &right) noexcept
  {
    return !(left == right);
  }
  inline bool operator==(const error_condition &left, errc right) noexcept
  {
    return left == make_error_condition(right);
  }
  inline bool operator==(errc left, const error_condition &right) noexcept
  {
    return make_error_condition(left) == right;
  }
  inline bool operator!=(const error_condition &left, errc right) noexcept
  {
    return !(left == right);
  }
  inline bool operator!=(errc left, const error_condition &right) noexcept
  {
    return !(left == right);
  }

  inline string __system_error_message(const string &what_arg, const error_code &code)
  {
    if (what_arg.empty()) return code.message();
    string result = what_arg;
    result += ": ";
    result += code.message();
    return result;
  }

  class system_error : public runtime_error
  {
  public:
    system_error(error_code code) : runtime_error(code.message()), m_code(code) {}
    system_error(error_code code, const string &what_arg)
      : runtime_error(__system_error_message(what_arg, code)), m_code(code) {}
    system_error(error_code code, const char *what_arg)
      : runtime_error(__system_error_message(string(what_arg), code)), m_code(code) {}
    system_error(int value, const error_category &category)
      : runtime_error(error_code(value, category).message()), m_code(value, category) {}
    system_error(int value, const error_category &category, const string &what_arg)
      : runtime_error(__system_error_message(what_arg, error_code(value, category))),
        m_code(value, category) {}
    system_error(int value, const error_category &category, const char *what_arg)
      : runtime_error(__system_error_message(string(what_arg), error_code(value, category))),
        m_code(value, category) {}

    const error_code &code() const noexcept { return m_code; }

  private:
    error_code m_code;
  };
}

#endif
