#ifndef _CPC_FUNCTIONAL
#define _CPC_FUNCTIONAL

#include <type_traits>
#include <utility>
#include <tuple>
#include <exception>

namespace std
{
  /* Searcher elements are compared through this predicate: it accepts any
     two element types, which one fixed `equal_to<T>` cannot express. */
  struct __equal_to_any
  {
    template<class T, class U>
    bool operator()(const T &left, const U &right) const { return left == right; }
  };

  /* C++17 default searcher: the pattern is held and the range search runs
     when the searcher is called. */
  template<class ForwardIterator1, class BinaryPredicate = __equal_to_any>
  class default_searcher
  {
  public:
    default_searcher(ForwardIterator1 pattern_begin, ForwardIterator1 pattern_end,
                     BinaryPredicate predicate = BinaryPredicate())
      : m_pattern_begin(pattern_begin), m_pattern_end(pattern_end),
        m_predicate(predicate) {}

    ForwardIterator1 begin() const { return m_pattern_begin; }
    ForwardIterator1 end() const { return m_pattern_end; }

    template<class ForwardIterator2>
    ForwardIterator2 operator()(ForwardIterator2 first, ForwardIterator2 last) const
    {
      if (m_pattern_begin == m_pattern_end) return first;
      for (; first != last; ++first)
      {
        ForwardIterator2 candidate = first;
        ForwardIterator1 pattern = m_pattern_begin;
        while (pattern != m_pattern_end && candidate != last
               && m_predicate(*pattern, *candidate))
        {
          ++pattern;
          ++candidate;
        }
        if (pattern == m_pattern_end) return first;
      }
      return last;
    }

  private:
    ForwardIterator1 m_pattern_begin;
    ForwardIterator1 m_pattern_end;
    BinaryPredicate m_predicate;
  };

  template<class T> class reference_wrapper;

  // Expression substitution selects the applicable INVOKE rule. Each int
  // overload is preferred to its long fallback only when its expression is
  // well-formed; the underlying member access enforces the declaring class.
  template<class Function, class Object>
  auto __cpc_invoke_pointer_data(Function &&function, Object &&object)
    -> decltype((*std::forward<Object>(object)).*std::forward<Function>(function))
  { return (*std::forward<Object>(object)).*std::forward<Function>(function); }

  template<class Function, class Object, class... Args>
  auto __cpc_invoke_pointer(Function &&function, Object &&object, int, Args&&... args)
    -> decltype(((*std::forward<Object>(object)).*std::forward<Function>(function))(std::forward<Args>(args)...))
  { return ((*std::forward<Object>(object)).*std::forward<Function>(function))(std::forward<Args>(args)...); }
  template<class Function, class Object>
  auto __cpc_invoke_pointer(Function &&function, Object &&object, long)
    -> decltype(__cpc_invoke_pointer_data(std::forward<Function>(function), std::forward<Object>(object)))
  { return __cpc_invoke_pointer_data(std::forward<Function>(function), std::forward<Object>(object)); }

  template<class Function, class Object>
  auto __cpc_invoke_wrapper_data(Function &&function, reference_wrapper<Object> object, int)
    -> decltype(object.get().*std::forward<Function>(function))
  { return object.get().*std::forward<Function>(function); }
  template<class Function, class Object, class... Args>
  auto __cpc_invoke_wrapper_data(Function &&function, Object &&object, long, Args&&... args)
    -> decltype(__cpc_invoke_pointer(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...))
  { return __cpc_invoke_pointer(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...); }

  template<class Function, class Object, class... Args>
  auto __cpc_invoke_wrapper(Function &&function, reference_wrapper<Object> object, int, Args&&... args)
    -> decltype((object.get().*std::forward<Function>(function))(std::forward<Args>(args)...))
  { return (object.get().*std::forward<Function>(function))(std::forward<Args>(args)...); }
  template<class Function, class Object, class... Args>
  auto __cpc_invoke_wrapper(Function &&function, Object &&object, long, Args&&... args)
    -> decltype(__cpc_invoke_wrapper_data(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...))
  { return __cpc_invoke_wrapper_data(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...); }

  template<class Function, class Object>
  auto __cpc_invoke_object_data(Function &&function, Object &&object, int)
    -> decltype(std::forward<Object>(object).*std::forward<Function>(function))
  { return std::forward<Object>(object).*std::forward<Function>(function); }
  template<class Function, class Object, class... Args>
  auto __cpc_invoke_object_data(Function &&function, Object &&object, long, Args&&... args)
    -> decltype(__cpc_invoke_wrapper(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...))
  { return __cpc_invoke_wrapper(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...); }

  template<class Function, class Object, class... Args>
  auto __cpc_invoke_object(Function &&function, Object &&object, int, Args&&... args)
    -> decltype((std::forward<Object>(object).*std::forward<Function>(function))(std::forward<Args>(args)...))
  { return (std::forward<Object>(object).*std::forward<Function>(function))(std::forward<Args>(args)...); }
  template<class Function, class Object, class... Args>
  auto __cpc_invoke_object(Function &&function, Object &&object, long, Args&&... args)
    -> decltype(__cpc_invoke_object_data(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...))
  { return __cpc_invoke_object_data(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...); }

  template<class Function, class... Args>
  auto __cpc_invoke(Function &&function, int, Args&&... args)
    -> decltype(std::forward<Function>(function)(std::forward<Args>(args)...))
  { return std::forward<Function>(function)(std::forward<Args>(args)...); }
  template<class Function, class Object, class... Args>
  auto __cpc_invoke(Function &&function, long, Object &&object, Args&&... args)
    -> decltype(__cpc_invoke_object(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...))
  { return __cpc_invoke_object(std::forward<Function>(function), std::forward<Object>(object), 0, std::forward<Args>(args)...); }

  template<class Function, class... Args>
  auto invoke(Function &&function, Args&&... args)
    -> decltype(__cpc_invoke(std::forward<Function>(function), 0, std::forward<Args>(args)...))
  { return __cpc_invoke(std::forward<Function>(function), 0, std::forward<Args>(args)...); }

  template<class T>
  class reference_wrapper
  {
  public:
    reference_wrapper(T &value) : m_pointer(&value) {}
    reference_wrapper(const reference_wrapper &other) : m_pointer(other.m_pointer) {}
    reference_wrapper &operator=(const reference_wrapper &other)
    {
      m_pointer = other.m_pointer;
      return *this;
    }
    operator T &() const { return *m_pointer; }
    T &get() const { return *m_pointer; }
    template<class... Args>
    auto operator()(Args&&... args) const
      -> decltype(std::invoke(get(), std::forward<Args>(args)...))
    { return std::invoke(get(), std::forward<Args>(args)...); }

  private:
    T *m_pointer;
  };

  template<class T>
  reference_wrapper<T> ref(T &value)
  {
    return reference_wrapper<T>(value);
  }

  template<class T>
  reference_wrapper<const T> cref(const T &value)
  {
    return reference_wrapper<const T>(value);
  }

  template<class Function>
  class __not_fn_result
  {
  public:
    explicit __not_fn_result(Function &&function)
      : m_function(std::forward<Function>(function)) {}

    template<class... Args>
    auto operator()(Args &&...args)
      -> decltype(!std::invoke(m_function, std::forward<Args>(args)...))
    {
      return !std::invoke(m_function, std::forward<Args>(args)...);
    }

  private:
    Function m_function;
  };

  template<class Function>
  __not_fn_result<typename decay<Function>::type>
  not_fn(Function &&function)
  {
    typedef typename decay<Function>::type stored_type;
    return __not_fn_result<stored_type>(std::forward<Function>(function));
  }

  template<class Function, class Bound>
  class __bind_result1
  {
  public:
    template<class Callable, class Argument>
    __bind_result1(Callable &&callable, Argument &&argument)
      : m_function(std::forward<Callable>(callable)),
        m_bound(std::forward<Argument>(argument)) {}

    template<class... Args>
    auto operator()(Args &&...args)
      -> decltype(std::invoke(m_function, m_bound,
                              std::forward<Args>(args)...))
    {
      return std::invoke(m_function, m_bound, std::forward<Args>(args)...);
    }

  private:
    Function m_function;
    Bound m_bound;
  };

  template<class Function, class Bound1, class Bound2>
  class __bind_result2
  {
  public:
    template<class Callable, class Argument1, class Argument2>
    __bind_result2(Callable &&callable, Argument1 &&argument1,
                   Argument2 &&argument2)
      : m_function(std::forward<Callable>(callable)),
        m_first(std::forward<Argument1>(argument1)),
        m_second(std::forward<Argument2>(argument2)) {}

    template<class... Args>
    auto operator()(Args &&...args)
      -> decltype(std::invoke(m_function, m_first, m_second,
                              std::forward<Args>(args)...))
    {
      return std::invoke(m_function, m_first, m_second,
                         std::forward<Args>(args)...);
    }

  private:
    Function m_function;
    Bound1 m_first;
    Bound2 m_second;
  };

  template<class Function, class Bound>
  __bind_result1<typename decay<Function>::type, typename decay<Bound>::type>
  bind(Function &&function, Bound &&bound)
  {
    typedef __bind_result1<typename decay<Function>::type,
                           typename decay<Bound>::type> result_type;
    return result_type(std::forward<Function>(function),
                       std::forward<Bound>(bound));
  }

  template<class Function, class Bound1, class Bound2>
  __bind_result2<typename decay<Function>::type,
                 typename decay<Bound1>::type,
                 typename decay<Bound2>::type>
  bind(Function &&function, Bound1 &&bound1, Bound2 &&bound2)
  {
    typedef __bind_result2<typename decay<Function>::type,
                           typename decay<Bound1>::type,
                           typename decay<Bound2>::type> result_type;
    return result_type(std::forward<Function>(function),
                       std::forward<Bound1>(bound1),
                       std::forward<Bound2>(bound2));
  }
}


namespace std {
class bad_function_call : public exception {
public: const char* what() const noexcept override { return "bad function call"; }
};
template<class Signature> class function;

template<class R,class... Args> class function<R(Args...)> {
  struct Target {
    virtual ~Target() {}
    virtual Target* clone() const = 0;
    virtual R call(Args... args) = 0;
  };
  template<class F> struct Callable : Target {
    F value;
    Callable(F f) : value(std::move(f)) {}
    Target* clone() const override { return new Callable(value); }
    R call(Args... args) override {
      return (R)value(std::forward<Args>(args)...);
    }
  };
  Target* target;
public:
  function() noexcept : target(0) {}
  function(decltype(nullptr)) noexcept : target(0) {}
  template<class F> function(F f) : target(new Callable<F>(std::move(f))) {}
  function(const function& f) : target(f.target?f.target->clone():0) {}
  function(function&& f) noexcept : target(f.target) { f.target=0; }
  ~function() { delete target; }
  function& operator=(function f) { swap(f); return *this; }
  function& operator=(decltype(nullptr)) noexcept { delete target; target=0; return *this; }
  void swap(function& f) noexcept { Target* t=target; target=f.target; f.target=t; }
  explicit operator bool() const noexcept { return target!=0; }
  R operator()(Args... args) const { if(!target) throw bad_function_call(); return target->call(std::forward<Args>(args)...); }
};
}
#endif
