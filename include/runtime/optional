#ifndef _CPC_OPTIONAL
#define _CPC_OPTIONAL

#include <utility>
#include <new>

namespace std
{
  struct nullopt_t
  {
    explicit constexpr nullopt_t(int) {}
  };

  constexpr nullopt_t nullopt(0);

  class bad_optional_access : public exception
  {
  public:
    const char *what() const noexcept override { return "bad optional access"; }
  };

  template<class T>
  class optional
  {
  public:
    typedef T value_type;

    constexpr optional() noexcept : m_storage(), m_engaged(false) {}
    constexpr optional(nullopt_t) noexcept : m_storage(), m_engaged(false) {}
    constexpr optional(const T &value) : m_storage(), m_engaged(false)
    {
      ::new (static_cast<void *>(&m_storage.value)) T(value);
      m_engaged = true;
    }
    constexpr optional(T &&value) : m_storage(), m_engaged(false)
    {
      ::new (static_cast<void *>(&m_storage.value)) T(static_cast<T &&>(value));
      m_engaged = true;
    }
    optional(const optional &other) : m_storage(), m_engaged(false)
    {
      if (other.m_engaged) emplace(other.m_storage.value);
    }
    optional(optional &&other) : m_storage(), m_engaged(false)
    {
      if (other.m_engaged) emplace(static_cast<T &&>(other.m_storage.value));
    }
    ~optional() { reset(); }

    optional &operator=(const optional &other)
    {
      if (other.m_engaged) *this = other.m_storage.value;
      else reset();
      return *this;
    }

    optional &operator=(optional &&other)
    {
      if (other.m_engaged) *this = static_cast<T &&>(other.m_storage.value);
      else reset();
      return *this;
    }

    optional &operator=(nullopt_t)
    {
      reset();
      return *this;
    }

    optional &operator=(const T &value)
    {
      if (m_engaged) m_storage.value = value;
      else emplace(value);
      return *this;
    }

    optional &operator=(T &&value)
    {
      if (m_engaged) m_storage.value = static_cast<T &&>(value);
      else emplace(static_cast<T &&>(value));
      return *this;
    }

    constexpr bool has_value() const { return m_engaged; }
    constexpr explicit operator bool() const { return m_engaged; }

    constexpr T &value() { if (!m_engaged) throw bad_optional_access(); return m_storage.value; }
    constexpr const T &value() const { if (!m_engaged) throw bad_optional_access(); return m_storage.value; }
    template<class U>
    T value_or(U &&fallback) const
    {
      return m_engaged ? m_storage.value
                       : static_cast<T>(std::forward<U>(fallback));
    }
    constexpr T &operator*() { return m_storage.value; }
    constexpr const T &operator*() const { return m_storage.value; }
    T *operator->() { return &m_storage.value; }
    const T *operator->() const { return &m_storage.value; }

    constexpr void reset() noexcept
    {
      if (m_engaged) {
        m_storage.value.~T();
        m_engaged = false;
      }
    }

    template<class... Args>
    constexpr T &emplace(Args &&...args)
    {
      reset();
      ::new (static_cast<void *>(&m_storage.value)) T(static_cast<Args &&>(args)...);
      m_engaged = true;
      return m_storage.value;
    }

  private:
    union Storage {
      char empty;
      T value;
      constexpr Storage() noexcept : empty() {}
      ~Storage() {}
    } m_storage;
    bool m_engaged;
  };
}

#endif
