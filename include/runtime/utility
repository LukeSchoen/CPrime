#ifndef _UTILITY
#define _UTILITY

#include <type_traits>
#include <stddef.h>

namespace std
{
  template<class T>
  T&& declval();

  template<class T>
  constexpr T&& forward(typename remove_reference<T>::type &value) noexcept
  {
    return static_cast<T&&>(value);
  }

  template<class T>
  constexpr T&& forward(typename remove_reference<T>::type &&value) noexcept
  {
    static_assert(!is_lvalue_reference<T>::value, "cannot forward an rvalue as an lvalue");
    return static_cast<T&&>(value);
  }

  template<class T>
  constexpr typename remove_reference<T>::type&& move(T &&value) noexcept
  {
    return static_cast<typename remove_reference<T>::type&&>(value);
  }

  template<class T>
  constexpr const T &as_const(T &value) noexcept
  {
    return value;
  }
  template<class T>
  void as_const(const T &&) = delete;

  template<class T, T... Values>
  struct integer_sequence
  {
    typedef T value_type;
    static constexpr size_t size() noexcept { return sizeof...(Values); }
  };

  template<size_t... Values>
  using index_sequence = integer_sequence<size_t, Values...>;

  template<class T, T Size, T... Values>
  struct __make_integer_sequence
      : __make_integer_sequence<T, Size - 1, Size - 1, Values...> {};
  template<class T, T... Values>
  struct __make_integer_sequence<T, 0, Values...>
  {
    typedef integer_sequence<T, Values...> type;
  };
  template<class T, T Size>
  using make_integer_sequence = typename __make_integer_sequence<T, Size>::type;
  template<size_t Size>
  using make_index_sequence = make_integer_sequence<size_t, Size>;

  template<class T, class U>
  constexpr T exchange(T &object, U &&replacement)
  {
    T previous = static_cast<T &&>(object);
    object = static_cast<U &&>(replacement);
    return previous;
  }

  template<class T>
  void swap(T &lhs, T &rhs)
  {
    T temporary = std::move(lhs);
    lhs = std::move(rhs);
    rhs = std::move(temporary);
  }

  template<class T> class reference_wrapper;
  template<class T> struct __unwrap_reference { typedef T type; };
  template<class T> struct __unwrap_reference<reference_wrapper<T>> { typedef T& type; };
  template<class T> void __pair_accept(T);
  template<class T, class U> auto __pair_constructible(int)
    -> decltype(T(declval<U>()), true_type{});
  template<class T, class U> false_type __pair_constructible(...);
  template<class T, class U> auto __pair_convertible(int)
    -> decltype(__pair_accept<T>(declval<U>()), true_type{});
  template<class T, class U> false_type __pair_convertible(...);
  template<class T1, class T2, class U1, class U2> struct __pair_conversion {
    static const bool constructible = decltype(__pair_constructible<T1,U1>(0))::value
      && decltype(__pair_constructible<T2,U2>(0))::value;
    static const bool implicit = decltype(__pair_convertible<T1,U1>(0))::value
      && decltype(__pair_convertible<T2,U2>(0))::value;
  };

  template<class T1, class T2> struct pair {
    typedef T1 first_type;
    typedef T2 second_type;
    T1 first;
    T2 second;

    constexpr pair() : first(), second() {}
    pair(const pair&) = default;
    pair(pair&&) = default;

    template<class U1, class U2,
      typename enable_if<__pair_conversion<T1,T2,U1&&,U2&&>::constructible
        && __pair_conversion<T1,T2,U1&&,U2&&>::implicit,int>::type = 0>
    constexpr pair(U1&& a, U2&& b)
      : first(std::forward<U1>(a)), second(std::forward<U2>(b)) {}
    template<class U1, class U2,
      typename enable_if<__pair_conversion<T1,T2,U1&&,U2&&>::constructible
        && !__pair_conversion<T1,T2,U1&&,U2&&>::implicit,long>::type = 0>
    explicit constexpr pair(U1&& a, U2&& b)
      : first(std::forward<U1>(a)), second(std::forward<U2>(b)) {}

    template<class U1, class U2,
      typename enable_if<__pair_conversion<T1,T2,const U1&,const U2&>::constructible
        && __pair_conversion<T1,T2,const U1&,const U2&>::implicit,int>::type = 0>
    constexpr pair(const pair<U1,U2>& other) : first(other.first), second(other.second) {}
    template<class U1, class U2,
      typename enable_if<__pair_conversion<T1,T2,const U1&,const U2&>::constructible
        && !__pair_conversion<T1,T2,const U1&,const U2&>::implicit,long>::type = 0>
    explicit constexpr pair(const pair<U1,U2>& other) : first(other.first), second(other.second) {}

    template<class U1, class U2,
      typename enable_if<__pair_conversion<T1,T2,U1&&,U2&&>::constructible
        && __pair_conversion<T1,T2,U1&&,U2&&>::implicit,int>::type = 0>
    constexpr pair(pair<U1,U2>&& other)
      : first(std::forward<U1>(other.first)), second(std::forward<U2>(other.second)) {}
    template<class U1, class U2,
      typename enable_if<__pair_conversion<T1,T2,U1&&,U2&&>::constructible
        && !__pair_conversion<T1,T2,U1&&,U2&&>::implicit,long>::type = 0>
    explicit constexpr pair(pair<U1,U2>&& other)
      : first(std::forward<U1>(other.first)), second(std::forward<U2>(other.second)) {}

    pair& operator=(const pair& other) {
      first = other.first; second = other.second; return *this;
    }
    pair& operator=(pair&& other) {
      first = std::forward<T1>(other.first);
      second = std::forward<T2>(other.second); return *this;
    }
    template<class U1, class U2> pair& operator=(const pair<U1,U2>& other) {
      first = other.first; second = other.second; return *this;
    }
    template<class U1, class U2> pair& operator=(pair<U1,U2>&& other) {
      first = std::forward<U1>(other.first);
      second = std::forward<U2>(other.second); return *this;
    }
    void swap(pair& other) { std::swap(first,other.first); std::swap(second,other.second); }
  };

  template<class T1, class T2>
  constexpr pair<typename __unwrap_reference<typename decay<T1>::type>::type,
                 typename __unwrap_reference<typename decay<T2>::type>::type>
  make_pair(T1&& first, T2&& second) {
    typedef pair<typename __unwrap_reference<typename decay<T1>::type>::type,
                 typename __unwrap_reference<typename decay<T2>::type>::type> result_type;
    return result_type(std::forward<T1>(first),std::forward<T2>(second));
  }
  template<class T1, class T2> bool operator==(const pair<T1,T2>& a,const pair<T1,T2>& b) {
    return a.first == b.first && a.second == b.second;
  }
  template<class T1, class T2> bool operator!=(const pair<T1,T2>& a,const pair<T1,T2>& b) { return !(a==b); }
  template<class T1, class T2> bool operator<(const pair<T1,T2>& a,const pair<T1,T2>& b) {
    return a.first < b.first || (!(b.first < a.first) && a.second < b.second);
  }
  template<class T1, class T2> bool operator>(const pair<T1,T2>& a,const pair<T1,T2>& b) { return b<a; }
  template<class T1, class T2> bool operator<=(const pair<T1,T2>& a,const pair<T1,T2>& b) { return !(b<a); }
  template<class T1, class T2> bool operator>=(const pair<T1,T2>& a,const pair<T1,T2>& b) { return !(a<b); }
  template<class T1, class T2> void swap(pair<T1,T2>& a,pair<T1,T2>& b) { a.swap(b); }

}

#endif
