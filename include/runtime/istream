#ifndef _CPC_ISTREAM
#define _CPC_ISTREAM

#include <stdio.h>
#include <stddef.h>

namespace std
{
  class istream
  {
  public:
    explicit istream(FILE *stream = stdin) : m_stream(stream), m_count(0) {}

    istream &read(char *data, size_t count)
    {
      m_count = fread(data, 1, count, m_stream);
      return *this;
    }

    size_t gcount() const { return m_count; }

  private:
    FILE *m_stream;
    size_t m_count;
  };
}

#endif
