#ifndef _CPC_ARRAY
#define _CPC_ARRAY

#include <stddef.h>

namespace std
{
  template<class T, size_t N>
  struct array
  {
    typedef T value_type;
    typedef size_t size_type;
    typedef T &reference;
    typedef const T &const_reference;
    typedef T *iterator;
    typedef const T *const_iterator;

    T m_elements[N ? N : 1];

    array() {}

    array(const array &other)
    {
      for (size_type i = 0; i < N; ++i)
        m_elements[i] = other.m_elements[i];
    }

    array &operator=(const array &other)
    {
      if (this != &other)
        for (size_type i = 0; i < N; ++i)
          m_elements[i] = other.m_elements[i];
      return *this;
    }

    reference at(size_type index) { return m_elements[index]; }
    const_reference at(size_type index) const { return m_elements[index]; }
    reference operator[](size_type index) { return m_elements[index]; }
    const_reference operator[](size_type index) const { return m_elements[index]; }
    reference front() { return m_elements[0]; }
    const_reference front() const { return m_elements[0]; }
    reference back() { return m_elements[N - 1]; }
    const_reference back() const { return m_elements[N - 1]; }
    T *data() { return m_elements; }
    const T *data() const { return m_elements; }
    iterator begin() { return m_elements; }
    const_iterator begin() const { return m_elements; }
    iterator end() { return m_elements + N; }
    const_iterator end() const { return m_elements + N; }
    size_type size() const { return N; }
    size_type max_size() const { return N; }
    bool empty() const { return N == 0; }

    void fill(const T &value)
    {
      for (size_type i = 0; i < N; ++i)
        m_elements[i] = value;
    }

    void swap(array &other)
    {
      for (size_type i = 0; i < N; ++i)
      {
        T temporary = m_elements[i];
        m_elements[i] = other.m_elements[i];
        other.m_elements[i] = temporary;
      }
    }
  };
}

#endif
