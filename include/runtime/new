#ifndef _CPC_NEW
#define _CPC_NEW

#include <exception>
#include <cstddef>

namespace std {
  struct nothrow_t {
    explicit nothrow_t() = default;
  };
  inline constexpr nothrow_t nothrow{};

  class bad_alloc : public exception {
  public:
    bad_alloc() noexcept {}
    const char *what() const noexcept override { return "std::bad_alloc"; }
  };
}

/* Placement new is handled natively by the compiler. */

#endif
