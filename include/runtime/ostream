#ifndef _CPC_OSTREAM
#define _CPC_OSTREAM

#include <ios>
#include <wchar.h>
#include <stddef.h>

namespace std
{
  template<class C, class Traits> class basic_ostream : public basic_ios<C,Traits>
  {
  public:
    explicit basic_ostream(FILE *stream = stdout) : basic_ios<C,Traits>(stream) {}

    basic_ostream &put(C value)
    {
      if (sizeof(C) == 1) { if (fputc((unsigned char)value, this->m_stream) == EOF) this->setstate(ios_base::badbit); }
      else if (fputwc((wchar_t)value, this->m_stream) == WEOF) this->setstate(ios_base::badbit);
      return *this;
    }

    basic_ostream &write(const C *data, streamsize count)
    {
      for (streamsize i = 0; i < count && !this->fail(); ++i) put(data[i]);
      return *this;
    }

    basic_ostream &flush()
    {
      if (fflush(this->m_stream) != 0) this->setstate(ios_base::badbit);
      return *this;
    }

    basic_ostream &operator<<(const char *value)
    {
      const char *text = value ? value : "(null)"; while (*text) put((C)*text++);
      return *this;
    }

    basic_ostream &operator<<(char value) { return put(value); }
    basic_ostream &operator<<(bool value) { return *this << (value ? "true" : "false"); }
    basic_ostream &operator<<(short value) { fprintf(this->m_stream, "%hd", value); return *this; }
    basic_ostream &operator<<(unsigned short value) { fprintf(this->m_stream, "%hu", value); return *this; }
    basic_ostream &operator<<(int value) { fprintf(this->m_stream, "%d", value); return *this; }
    basic_ostream &operator<<(unsigned int value) { fprintf(this->m_stream, "%u", value); return *this; }
    basic_ostream &operator<<(long value) { fprintf(this->m_stream, "%ld", value); return *this; }
    basic_ostream &operator<<(unsigned long value) { fprintf(this->m_stream, "%lu", value); return *this; }
    basic_ostream &operator<<(long long value) { fprintf(this->m_stream, "%lld", value); return *this; }
    basic_ostream &operator<<(unsigned long long value) { fprintf(this->m_stream, "%llu", value); return *this; }
    basic_ostream &operator<<(float value) { fprintf(this->m_stream, "%g", (double)value); return *this; }
    basic_ostream &operator<<(double value) { fprintf(this->m_stream, "%g", value); return *this; }
    basic_ostream &operator<<(const void *value) { fprintf(this->m_stream, "%p", value); return *this; }

    typedef basic_ostream &(*manipulator)(basic_ostream &);
    basic_ostream &operator<<(manipulator function) { return function(*this); }

  };

  template<class C, class Traits> inline basic_ostream<C,Traits> &endl(basic_ostream<C,Traits> &stream)
  {
    stream.put('\n');
    return stream.flush();
  }

  template<class C, class Traits> inline basic_ostream<C,Traits> &flush(basic_ostream<C,Traits> &stream)
  {
    return stream.flush();
  }
}

#endif
