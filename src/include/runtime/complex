#ifndef _CPC_COMPLEX
#define _CPC_COMPLEX

namespace std
{
  template<class T>
  class complex
  {
  public:
    typedef T value_type;

    complex(const T &real = T(), const T &imaginary = T())
      : m_real(real), m_imaginary(imaginary) {}

    T real() const { return m_real; }
    T imag() const { return m_imaginary; }
    void real(T value) { m_real = value; }
    void imag(T value) { m_imaginary = value; }

    complex &operator+=(const complex &other)
    {
      m_real += other.m_real;
      m_imaginary += other.m_imaginary;
      return *this;
    }
    complex &operator-=(const complex &other)
    {
      m_real -= other.m_real;
      m_imaginary -= other.m_imaginary;
      return *this;
    }

  private:
    T m_real;
    T m_imaginary;
  };

  template<class T>
  complex<T> operator+(complex<T> left, const complex<T> &right)
  {
    left += right;
    return left;
  }
  template<class T>
  complex<T> operator-(complex<T> left, const complex<T> &right)
  {
    left -= right;
    return left;
  }
}

#endif
