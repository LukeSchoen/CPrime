#ifndef _CPC_TUPLE
#define _CPC_TUPLE

#include <stddef.h>
#include <type_traits>
#include <utility>

namespace std
{
  /* One storage slot per element. Reference elements bind instead of storing,
     so a tuple of references shares its referents. */
  template<size_t Index, class T>
  struct __tuple_leaf
  {
    T __value;
    __tuple_leaf() : __value() {}
    template<class U>
    explicit __tuple_leaf(U &&value) : __value(std::forward<U>(value)) {}
  };

  template<size_t Index, class... Types>
  struct __tuple_impl;

  template<size_t Index>
  struct __tuple_impl<Index>
  {
    __tuple_impl() {}
    template<class... Values>
    explicit __tuple_impl(Values &&...) {}

    /* The end of the leaf chain: every element has been appended to the
       argument list, so the function is ready to be called. */
    template<class Function, class... Arguments>
    auto __apply(Function &&function, Arguments &&...arguments) const
      -> decltype(static_cast<Function &&>(function)(
                    static_cast<Arguments &&>(arguments)...))
    {
      return static_cast<Function &&>(function)(
          static_cast<Arguments &&>(arguments)...);
    }
  };

  template<size_t Index, class First, class... Rest>
  struct __tuple_impl<Index, First, Rest...>
    : __tuple_leaf<Index, First>, __tuple_impl<Index + 1, Rest...>
  {
    typedef __tuple_leaf<Index, First> __head;
    typedef __tuple_impl<Index + 1, Rest...> __tail;

    __tuple_impl() : __head(), __tail() {}
    __tuple_impl(const __tuple_impl &) = default;
    __tuple_impl(__tuple_impl &&) = default;

    template<class U, class... Values>
    explicit __tuple_impl(U &&value, Values &&...rest)
      : __head(std::forward<U>(value)), __tail(std::forward<Values>(rest)...) {}

    /* Append this element to the call under construction and let the tail
       append its own: the argument list then keeps tuple order without an
       index sequence. */
    template<class Function, class... Arguments>
    auto __apply(Function &&function, Arguments &&...arguments)
      -> decltype(static_cast<__tail &>(*this).__apply(
                    static_cast<Function &&>(function),
                    static_cast<Arguments &&>(arguments)...,
                    static_cast<__head &>(*this).__value))
    {
      return static_cast<__tail &>(*this).__apply(
          static_cast<Function &&>(function),
          static_cast<Arguments &&>(arguments)...,
          static_cast<__head &>(*this).__value);
    }

    template<class Function, class... Arguments>
    auto __apply(Function &&function, Arguments &&...arguments) const
      -> decltype(static_cast<const __tail &>(*this).__apply(
                    static_cast<Function &&>(function),
                    static_cast<Arguments &&>(arguments)...,
                    static_cast<const __head &>(*this).__value))
    {
      return static_cast<const __tail &>(*this).__apply(
          static_cast<Function &&>(function),
          static_cast<Arguments &&>(arguments)...,
          static_cast<const __head &>(*this).__value);
    }
  };

  template<class... Types>
  class tuple : public __tuple_impl<0, Types...>
  {
    typedef __tuple_impl<0, Types...> __base;
  public:
    tuple() : __base() {}
    tuple(const tuple &) = default;
    tuple(tuple &&) = default;
    tuple &operator=(const tuple &) = default;
    tuple &operator=(tuple &&) = default;

    template<class... Values>
    explicit tuple(Values &&...values)
      : __base(std::forward<Values>(values)...) {}
  };

  template<class T>
  struct tuple_size;
  template<class... Types>
  struct tuple_size<tuple<Types...> >
  {
    static const size_t value = sizeof...(Types);
    typedef size_t value_type;
  };
  template<class T>
  struct tuple_size<const T> : tuple_size<T> {};
  template<class T>
  struct tuple_size<volatile T> : tuple_size<T> {};

  template<size_t Index, class T>
  struct tuple_element;
  template<class First, class... Rest>
  struct tuple_element<0, tuple<First, Rest...> >
  {
    typedef First type;
  };
  template<size_t Index, class First, class... Rest>
  struct tuple_element<Index, tuple<First, Rest...> >
  {
    typedef typename tuple_element<Index - 1, tuple<Rest...> >::type type;
  };
  template<size_t Index, class T>
  struct tuple_element<Index, const T>
  {
    typedef const typename tuple_element<Index, T>::type type;
  };

  /* The receiver is deduced as a whole instead of opening the class's pack:
     a pack expansion nested in a function parameter type (`tuple<Ts...>`) is
     not a deduced context for this compiler, while `tuple_element` resolves
     the index inside the class specialization. */
  template<size_t Index, class Tuple>
  typename tuple_element<Index, Tuple>::type &get(Tuple &value)
  {
    typedef typename tuple_element<Index, Tuple>::type type;
    return static_cast<__tuple_leaf<Index, type> &>(value).__value;
  }

  template<size_t Index, class Tuple>
  const typename tuple_element<Index, Tuple>::type &get(const Tuple &value)
  {
    typedef typename tuple_element<Index, Tuple>::type type;
    return static_cast<const __tuple_leaf<Index, type> &>(value).__value;
  }

  /* Element access by type.  The receiver is again deduced as a whole, and a
     partial specialization opens its pack, so the index comes from one
     recursive helper rather than from a pack expansion in the parameter
     type. */
  template<class T, class... Types>
  struct __tuple_type_index;

  template<class T, class... Rest>
  struct __tuple_type_index<T, T, Rest...>
  {
    static const size_t value = 0;
  };

  template<class T, class First, class... Rest>
  struct __tuple_type_index<T, First, Rest...>
  {
    static const size_t value = 1 + __tuple_type_index<T, Rest...>::value;
  };

  template<class T, class... Types>
  T &get(tuple<Types...> &value)
  {
    return get<__tuple_type_index<T, Types...>::value>(value);
  }

  template<class T, class... Types>
  const T &get(const tuple<Types...> &value)
  {
    return get<__tuple_type_index<T, Types...>::value>(value);
  }

  /* One pack expansion each: the answer type is built from `decay<Types>...`
     and the values are forwarded one per parameter. */
  template<class... Types>
  tuple<typename decay<Types>::type...>
  make_tuple(Types &&...values)
  {
    typedef tuple<typename decay<Types>::type...> result_type;
    return result_type(std::forward<Types>(values)...);
  }

  template<class... Types>
  tuple<Types &...> tie(Types &...values)
  {
    return tuple<Types &...>(values...);
  }

  /* apply walks the storage chain: every leaf appends its own element, so one
     element list becomes one argument list. */
  template<class Function, class... Types>
  struct __apply_result
  {
    typedef decltype(declval<Function>()(declval<Types &>()...)) type;
  };
  template<class Function, class... Types>
  struct __apply_const_result
  {
    typedef decltype(declval<Function>()(declval<const Types &>()...)) type;
  };

  template<class Function, class... Types>
  typename __apply_result<Function &&, Types...>::type
  apply(Function &&function, tuple<Types...> &arguments)
  {
    return arguments.__apply(std::forward<Function>(function));
  }

  template<class Function, class... Types>
  typename __apply_const_result<Function &&, Types...>::type
  apply(Function &&function, const tuple<Types...> &arguments)
  {
    return arguments.__apply(std::forward<Function>(function));
  }

  template<class Function, class T1, class T2>
  auto apply(Function &&function, pair<T1, T2> &arguments)
    -> decltype(std::forward<Function>(function)(arguments.first,
                                                 arguments.second))
  {
    return std::forward<Function>(function)(arguments.first, arguments.second);
  }

  template<class Function, class T1, class T2>
  auto apply(Function &&function, const pair<T1, T2> &arguments)
    -> decltype(std::forward<Function>(function)(arguments.first,
                                                 arguments.second))
  {
    return std::forward<Function>(function)(arguments.first, arguments.second);
  }

  /* make_from_tuple builds the target from the tuple's elements, reusing the
     leaf walk that turns them into a constructor argument list. */
  template<class T>
  struct __from_tuple_constructor
  {
    template<class... Arguments>
    T operator()(Arguments &&...arguments) const
    {
      return T(static_cast<Arguments &&>(arguments)...);
    }
  };

  template<class T, class... Types>
  T make_from_tuple(tuple<Types...> &arguments)
  {
    return arguments.__apply(__from_tuple_constructor<T>());
  }

  template<class T, class... Types>
  T make_from_tuple(const tuple<Types...> &arguments)
  {
    return arguments.__apply(__from_tuple_constructor<T>());
  }

  template<class T, class... Types>
  T make_from_tuple(tuple<Types...> &&arguments)
  {
    return static_cast<tuple<Types...> &>(arguments).__apply(
        __from_tuple_constructor<T>());
  }

  template<class T, class... Types>
  T make_from_tuple(const tuple<Types...> &&arguments)
  {
    return arguments.__apply(__from_tuple_constructor<T>());
  }

  template<class... Types>
  tuple(Types...) -> tuple<Types...>;
}

#endif
