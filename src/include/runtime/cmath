#ifndef _CMATH
#define _CMATH

#include <math.h>
#include <cstdlib>
#include <type_traits>

inline float abs(float value) { return ::fabsf(value); }
inline double abs(double value) { return ::fabs(value); }
inline long double abs(long double value) { return ::fabsl(value); }

/* The C++ <math.h> contract adds the float and long double overloads of the
   absolute value functions.  Declaring them next to the C declarations lets
   the `using ::fabs;` below import one set for every floating type, exactly
   as the `abs` overloads above are imported. */
inline float fabs(float value) { return ::fabsf(value); }
inline long double fabs(long double value) { return ::fabsl(value); }

#undef isinf
#undef isnan
#undef isnormal
#undef signbit
#undef isfinite

// Keep the C compatibility names usable after replacing math.h's macros.
// Classify in the original floating type so float subnormals stay subnormal.
#define CPC_MATH_CLASSIFY_OVERLOADS(Type, Classify, Sign) \
  inline bool isnan(Type value) { return Classify(value) == FP_NAN; } \
  inline bool isinf(Type value) { return Classify(value) == FP_INFINITE; } \
  inline bool isnormal(Type value) { return Classify(value) == FP_NORMAL; } \
  inline bool isfinite(Type value) { int c = Classify(value); return c != FP_NAN && c != FP_INFINITE; } \
  inline bool signbit(Type value) { return Sign(value) != 0; }
CPC_MATH_CLASSIFY_OVERLOADS(float, __fpclassifyf, __signbitf)
CPC_MATH_CLASSIFY_OVERLOADS(double, __fpclassify, __signbit)
CPC_MATH_CLASSIFY_OVERLOADS(long double, __fpclassifyl, __signbitl)
#undef CPC_MATH_CLASSIFY_OVERLOADS

namespace std
{
  /* Import the C declarations instead of wrapping them. A separate
     std::fabs(double) is a different function from ::fabs(double), so an
     unqualified fabs(x) becomes ambiguous in any translation unit that also
     has `using namespace std;` in scope. */
  using ::fabs;
  using ::fabsf;
  using ::fabsl;
  template<typename T>
  inline typename enable_if<is_integral<T>::value, double>::type fabs(T value)
  { return ::fabs(static_cast<double>(value)); }
  using ::abs;
  using ::exp;
  using ::expf;
  using ::expl;
  using ::floor;
  using ::floorf;
  using ::floorl;
  template<typename T>
  inline typename enable_if<is_integral<T>::value, double>::type floor(T value)
  { return ::floor(static_cast<double>(value)); }
  using ::sqrt;
  using ::sqrtf;
  using ::sqrtl;

  // Floating overloads retain the operand's precision; integral operands use
  // the additional double overloads required by the C++ math interface.
  using ::isnan;
  using ::isinf;
  using ::isnormal;
  using ::signbit;
  using ::isfinite;

  template<typename T>
  bool isnan(T value) { return ::isnan(static_cast<double>(value)); }

  template<typename T>
  bool isinf(T value) { return ::isinf(static_cast<double>(value)); }

  template<typename T>
  bool isnormal(T value) { return ::isnormal(static_cast<double>(value)); }

  template<typename T>
  bool signbit(T value) { return ::signbit(static_cast<double>(value)); }

  template<typename T>
  bool isfinite(T value) { return ::isfinite(static_cast<double>(value)); }

  template<typename T>
  double sqrt(T value) { return ::sqrt(static_cast<double>(value)); }
}

#endif
